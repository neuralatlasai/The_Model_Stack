---
/**
 * Volume map (volume pages): the volume as a flow — the chapters in earlier
 * volumes it builds on, its parts as rows of six compact chapter tiles (one
 * cell per section), and the chapters in later volumes it unlocks.
 *
 * Shares PartMap's styles and behaviour (client part-map.ts): pointing at a
 * tile lights its prerequisites (blue) and dependents (oxblood) inside the
 * volume and on either side, and fills the fixed-size readout.
 */
import type { LibraryModel } from '../../lib/library-model.ts';
import { compactCount } from '../../lib/library-model.ts';
import { jsonForHtml } from '../../lib/json.ts';
import FlowSide from './FlowSide.astro';
import { crossingLinks, flowSentence } from './lib/flow.ts';

interface Props {
  model: LibraryModel;
  volume: number;
}

const { model, volume: volumeNumber } = Astro.props;
const volume = model.volumes.find((candidate) => candidate.n === volumeNumber);
const byN = new Map(model.chapters.map((chapter) => [chapter.n, chapter]));
const parts = (volume?.parts ?? []).map((n) => model.parts.find((p) => p.n === n)).filter((p) => p !== undefined);
const own = parts.flatMap((p) => p.chapters.map((n) => byN.get(n)).filter((chapter) => chapter !== undefined));
const flow = crossingLinks(own, model.parts);
const sum = (pick: (chapter: (typeof own)[number]) => number): number => own.reduce((total, chapter) => total + pick(chapter), 0);
const totals = [
  `${String(sum((chapter) => chapter.sectionsWritten))} of ${String(sum((chapter) => chapter.sections.length))} sections`,
  `${compactCount(sum((chapter) => chapter.words))} words`,
  `${String(sum((chapter) => chapter.figures))} figures`,
  `${String(sum((chapter) => chapter.equations))} equations`,
].join(' · ');
---

{
  volume !== undefined && own.length > 0 && (
    <section class="pm pm--volume" data-part-map aria-labelledby="vm-title">
      <p class="pm-head">
        <span class="pm-head__title" id="vm-title">Volume {volume.numeral}, as a flow</span>
        <span class="pm-head__note">point at a chapter or link</span>
      </p>
      <div class="pm-flow">
        <FlowSide side="in" label="Builds on" aria="Builds on, from earlier volumes" none="No earlier volume — this volume opens the book." groups={flow.inGroups} chapters={byN} />

        <div class="pm-rows" data-pm-tiles>
          {parts.map((part) => (
            <div class="pm-vrow" data-domain={part.domain}>
              <a class="pm-vrow__label" href={part.url}>
                <span class="pm-vrow__num">{part.numeral}</span>
                <span class="pm-vrow__title">{part.title}</span>
              </a>
              <ol class="pm-tiles pm-tiles--row" role="list">
                {part.chapters.map((n, index) => {
                  const chapter = byN.get(n);
                  if (chapter === undefined) return null;
                  return (
                    <li
                      class:list={['pm-tile', chapter.written ? 'is-written' : 'is-planned', { 'has-draft': !chapter.written && chapter.sectionsWritten > 0 }]}
                      data-pm-tile={chapter.n}
                      data-pm-in={chapter.prereqs.join(' ')}
                      data-pm-out={chapter.unlocks.join(' ')}
                    >
                      <a class="pm-tile__link" href={chapter.url} tabindex={index === 0 && part === parts[0] ? 0 : -1} aria-label={`${chapter.number} ${chapter.title}. ${chapter.state}.`}>
                        <span class="pm-tile__n">{chapter.number}</span>
                        <span class="pm-tile__t">{chapter.short}</span>
                      </a>
                      <span class="pm-tile__cells">
                        {chapter.sections.map((section) => (
                          <a class:list={['pm-cell', section.written ? 'is-written' : 'is-planned']} href={section.url} tabindex="-1" title={`${section.number} ${section.title}${section.written ? '' : ' · planned'}`}>
                            <span class="sh-visually-hidden">
                              {section.number} {section.title}
                            </span>
                          </a>
                        ))}
                      </span>
                      <span class="pm-tile__m">{chapter.words > 0 ? `${compactCount(chapter.words)} words` : 'planned'}</span>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
        </div>

        <FlowSide side="out" label="Unlocks" aria="Unlocks, in later volumes" none="No later chapter lists this volume yet." groups={flow.outGroups} chapters={byN} />
      </div>

      <div class="pm-readout" aria-live="polite" data-pm-readout>
        <p class="pm-readout__kicker" data-pm-kicker>
          Volume {volume.numeral} · {parts.length} parts · {volume.written} of {own.length} chapters written
        </p>
        <p class="pm-readout__title" data-pm-title>
          {totals}
        </p>
        <p class="pm-readout__body" data-pm-body>
          {flowSentence(flow, byN)}
        </p>
      </div>

      <script is:inline type="application/json" data-pm-data set:html={jsonForHtml(
        Object.fromEntries(own.map((chapter) => [chapter.n, { title: chapter.title, state: chapter.state, summary: chapter.summary === '' ? chapter.plan : chapter.summary, words: chapter.words, figures: chapter.figures, equations: chapter.equations, sections: `${String(chapter.sectionsWritten)}/${String(chapter.sections.length)}` }])),
      )} />
    </section>
  )
}
