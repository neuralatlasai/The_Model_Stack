---
/**
 * Compact, research-oriented header (UI_UX §9, CONTENT_CONTRACT §3 items 1–4):
 * identity line, number + title, one-sentence thesis, meta line. No hero; the
 * first viewport goes to content. Sections derive the identity line from
 * breadcrumbs; the metadata preserves authored scope and the revision date.
 */
import type { ResearchDocument } from '@atlas/core';
import { inlineToText } from '@atlas/core';
import Inline from './Inline.astro';
import { identityLine, sentenceCase } from './lib/header.ts';

interface Props {
  doc: ResearchDocument;
  compact?: boolean;
  showThesis?: boolean;
}

const { doc, compact = false, showThesis = true } = Astro.props;
const { header } = doc;
const identity = identityLine(doc);
const thesis = header.thesis === null ? null : sentenceCase(header.thesis);
// Preserve useful authored context rather than replacing it with object totals.
const context = inlineToText(header.metaLine ?? [])
  .split('·')
  .map((part) => part.trim())
  .filter((part) => /^(?:artifact|prerequisites|scope|deliverable|assumptions):/iu.test(part))
  .join(' · ');
---

<header class:list={['rb-header', { 'aw-document-meta': compact }]}>
  {!compact && identity !== null && <p class="rb-header__identity">{identity}</p>}
  {!compact && (
    <h1 class="rb-header__title">
      {header.number !== null && <span class="rb-header__number">{header.number}</span>}
      <span class="rb-header__text">{header.title}</span>
    </h1>
  )}
  {showThesis && thesis !== null && (
    <p class="rb-header__thesis">
      <Inline nodes={thesis} />
    </p>
  )}
  <p class="rb-header__meta">
    {context !== '' && <>{context} · </>}
    <time datetime={doc.meta.updatedAt}>Updated {doc.meta.updatedAt}</time>
  </p>
</header>
