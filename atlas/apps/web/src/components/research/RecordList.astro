---
/**
 * Record list: a ledger table set as a list of records (one entry per row)
 * instead of a 7–10 column grid squeezed into the reading measure.
 *
 * Used for the reference-stack coverage table (chapter pages) and the
 * references table (references.md). Columns are mapped by header text, so
 * the differing column orders across chapters are handled; any column the
 * mapping does not claim is appended to the meta line, so nothing is lost.
 *
 *   ┌ kicker · title                                   (identifier line)
 *   │ subtitle                                          (who / which layer)
 *   │ body                                              (the substantive cell)
 *   └ meta · meta · meta                                (routing and status)
 */
import { inlineToText, type Inline as InlineNode, type TableBlock } from '@atlas/core';
import Inline from './Inline.astro';

interface Props {
  table: TableBlock;
  layout: 'stack-coverage' | 'references';
}

const { table, layout } = Astro.props;

type Slot = 'kicker' | 'title' | 'subtitle' | 'body' | 'meta';

/** Header prefix (lowercase) → slot, per layout. First match wins. */
const MAPPINGS: Readonly<Record<Props['layout'], readonly (readonly [string, Slot])[]>> = {
  'stack-coverage': [
    ['stack section', 'kicker'],
    ['entry', 'title'],
    ['stack layer', 'subtitle'],
    ['what', 'body'],
    ['surface', 'meta'],
    ['section', 'meta'],
    ['evidence', 'meta'],
  ],
  references: [
    ['key', 'kicker'],
    ['work', 'title'],
    ['authors', 'subtitle'],
    ['venue', 'subtitle'],
    ['used for', 'body'],
    ['type', 'meta'],
    ['status', 'meta'],
    ['primary url', 'meta'],
    ['official code', 'meta'],
    ['accessed', 'meta'],
  ],
};

const headers = table.columns.map((column) => inlineToText(column.header).trim().toLowerCase());
const slotOf = headers.map((header) => MAPPINGS[layout].find(([prefix]) => header.startsWith(prefix))?.[1] ?? 'meta');
const labelOf = table.columns.map((column) => inlineToText(column.header).trim());

const isEmpty = (cell: readonly InlineNode[]): boolean => {
  const text = inlineToText(cell).trim();
  return text === '' || text === '—' || text === '-' || text.toLowerCase() === 'null' || text.toLowerCase() === 'n/a';
};

const records = table.rows.map((row) => {
  const pick = (slot: Slot) =>
    row
      .map((cell, index) => ({ cell, index }))
      .filter(({ cell, index }) => slotOf[index] === slot && !isEmpty(cell))
      .map(({ cell, index }) => ({ cell, label: labelOf[index] ?? '' }));
  return { kicker: pick('kicker'), title: pick('title'), subtitle: pick('subtitle'), body: pick('body'), meta: pick('meta') };
});
---

<ol class={`rb-records rb-records--${layout}`} role="list">
  {
    records.map((record) => (
      <li class="rb-records__item">
        <p class="rb-records__head">
          {record.kicker.map(({ cell }) => (
            <span class="rb-records__kicker">
              <Inline nodes={cell} />
            </span>
          ))}
          {record.title.map(({ cell }) => (
            <span class="rb-records__title">
              <Inline nodes={cell} />
            </span>
          ))}
        </p>
        {record.subtitle.length > 0 && (
          <p class="rb-records__sub">
            {record.subtitle.map(({ cell }, index) => (
              <>
                {index > 0 && <span class="rb-records__sep" aria-hidden="true"> · </span>}
                <Inline nodes={cell} />
              </>
            ))}
          </p>
        )}
        {record.body.map(({ cell }) => (
          <p class="rb-records__body">
            <Inline nodes={cell} />
          </p>
        ))}
        {record.meta.length > 0 && (
          <dl class="rb-records__meta">
            {record.meta.map(({ cell, label }) => (
              <div class="rb-records__field">
                <dt>{label}</dt>
                <dd>
                  <Inline nodes={cell} />
                </dd>
              </div>
            ))}
          </dl>
        )}
      </li>
    ))
  }
</ol>
