---
/**
 * One side of a part or volume map (PartMap.astro, VolumeMap.astro): the
 * outside chapters it builds on or unlocks, one row per part, each chapter a
 * number chip — solid when written, dashed while planned. The chip's short
 * title stays in the accessibility tree; its full title is the tooltip and
 * the readout names it on hover (client part-map.ts reads `title`).
 */
import type { FlowGroup } from './lib/flow.ts';
import { pad2 } from './lib/flow.ts';

interface Chapter {
  readonly url: string;
  readonly title: string;
  readonly short: string;
  readonly written: boolean;
}

interface Props {
  side: 'in' | 'out';
  label: string;
  aria: string;
  none: string;
  groups: readonly FlowGroup[];
  chapters: ReadonlyMap<number, Chapter>;
}

const { side, label, aria, none, groups, chapters } = Astro.props;
const total = groups.reduce((sum, group) => sum + group.items.length, 0);
---

<div class={`pm-side pm-side--${side}`} aria-label={aria}>
  <p class="pm-side__label">
    {label}
    {total > 0 && <span class="pm-side__count">{total}</span>}
  </p>
  {groups.length === 0 ? (
    <p class="pm-side__none">{none}</p>
  ) : (
    groups.map((group) => (
      <div class="pm-group">
        <p class="pm-group__head">
          <span class="sh-visually-hidden">Part </span>
          {group.numeral}
        </p>
        <ul class="pm-chips" role="list">
          {group.items.map(({ n, via }) => {
            const chapter = chapters.get(n);
            return (
              <li>
                <a
                  class:list={['pm-chip', { 'is-written': chapter?.written === true }]}
                  href={chapter?.url}
                  data-pm-ext={n}
                  data-pm-via={via.join(' ')}
                  title={chapter?.title}
                >
                  <span class="pm-chip__n">{pad2(n)}</span>
                  <span class="pm-chip__t">{chapter?.short}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  )}
</div>
