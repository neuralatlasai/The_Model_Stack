---
/** H3–H6 inside a region: serif, linkable, with a hover/focus "#" anchor. */
import type { HeadingBlock } from '@atlas/core';
import Inline from '../Inline.astro';
import { depthAttrs } from '../lib/dom.ts';

interface Props {
  block: HeadingBlock;
}

const { block } = Astro.props;
const Tag = `h${block.level}` as const;
---

<Tag id={block.anchor} class={`rb-h rb-h${block.level}`} {...depthAttrs(block.depth)}>
  <Inline nodes={block.content} />
  <a class="rb-anchor" href={`#${block.anchor}`}><span aria-hidden="true">#</span><span class="rb-vh">Link to this heading</span></a>
</Tag>
