---
/** Narrative prose: serif body at the reading measure. */
import type { ParagraphBlock } from '@atlas/core';
import Inline from '../Inline.astro';
import { depthAttrs } from '../lib/dom.ts';

interface Props {
  block: ParagraphBlock;
}

const { block } = Astro.props;
---

<p class="rb-p" id={block.anchor ?? undefined} {...depthAttrs(block.depth)}><Inline nodes={block.content} /></p>
