---
/**
 * Notes, one grammar each: historical (italic, smaller), caveat, warning
 * (correctness/safety only: a stronger rule in the accent), further reading,
 * and implementation note (impl id · version as a mono line).
 */
import type { NoteBlock } from '@atlas/core';
import Inline from '../Inline.astro';
import { depthAttrs } from '../lib/dom.ts';
import { NOTE_TITLES } from '../lib/grammar.ts';

interface Props {
  block: NoteBlock;
}

const { block } = Astro.props;
const showImpl = block.variant === 'implementation' && (block.impl !== null || block.version !== null);
---

<div class={`rb-note rb-note--${block.variant}`} role="note" id={block.anchor ?? undefined} {...depthAttrs(block.depth)}>
  {
    showImpl && (
      <p class="rb-note__impl">
        {block.impl !== null && <span class="rb-note__impl-id">{block.impl}</span>}
        {block.version !== null && <span class="rb-note__version">{block.version}</span>}
      </p>
    )
  }
  <p class="rb-note__text"><span class="rb-lead">{NOTE_TITLES[block.variant]}</span> <Inline nodes={block.content} /></p>
</div>
