---
/** Assumption: italic-led statement, sensitivity on its own line ("sensitivity →"). */
import type { AssumptionBlock } from '@atlas/core';
import Inline from '../Inline.astro';
import { depthAttrs } from '../lib/dom.ts';

interface Props {
  block: AssumptionBlock;
}

const { block } = Astro.props;
---

<div class="rb-asm" id={block.anchor ?? undefined} {...depthAttrs(block.depth)}>
  <p class="rb-asm__text"><em class="rb-asm__lead">Assumption.</em> <Inline nodes={block.content} /></p>
  {
    block.sensitivity !== null && (
      <p class="rb-asm__sens"><span class="rb-asm__arrow">sensitivity →</span> <Inline nodes={block.sensitivity} /></p>
    )
  }
</div>
