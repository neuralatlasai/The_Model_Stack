---
/** A single labelled observation (`> **Observation [LABEL].** …`). */
import type { ObservationBlock } from '@atlas/core';
import Inline from '../Inline.astro';
import EvidenceMark from '../inline/EvidenceMark.astro';
import { depthAttrs } from '../lib/dom.ts';

interface Props {
  block: ObservationBlock;
}

const { block } = Astro.props;
---

<div class="rb-observation" id={block.anchor ?? undefined} {...depthAttrs(block.depth)}>
  <p class="rb-observation__text"><span class="rb-lead">Observation</span>{block.label !== null && <Fragment> <EvidenceMark label={block.label} /></Fragment>} <Inline nodes={block.content} /></p>
</div>
