---
/**
 * Part map (part pages): the part as a flow through the book.
 *
 *   builds on   chapters in earlier parts that this part's chapters list as
 *               direct prerequisites, grouped by part
 *   the part    its six chapter tiles: number, title, one cell per section
 *               (filled when drafted), words · figures · equations, and the
 *               in-part chapters each one builds on
 *   unlocks     chapters in later parts that list this part's chapters as
 *               direct prerequisites
 *
 * Outside chapters are number chips in one row per part (solid when written,
 * dashed while planned); the chip's title and the readout name them.
 *
 * Connected (client part-map.ts): pointing at a tile lights the outside
 * chapters it builds on and unlocks, dims the rest, and fills a fixed-size
 * readout with the chapter's thesis and measures; pointing at an outside chip
 * lights the tiles that use it. Idle, the readout gives the part's totals and
 * a reading of its links. Every tile, cell, and chip is a link. Data comes
 * from lib/library-model.ts, so the numbers match the Library page.
 */
import type { LibraryModel } from '../../lib/library-model.ts';
import { compactCount } from '../../lib/library-model.ts';
import { jsonForHtml } from '../../lib/json.ts';
import FlowSide from './FlowSide.astro';
import { crossingLinks, flowSentence, pad2 as pad } from './lib/flow.ts';

interface Props {
  model: LibraryModel;
  part: number;
}

const { model, part: partNumber } = Astro.props;
const part = model.parts.find((candidate) => candidate.n === partNumber);
const byN = new Map(model.chapters.map((chapter) => [chapter.n, chapter]));
const own = (part?.chapters ?? []).map((n) => byN.get(n)).filter((chapter) => chapter !== undefined);
const ownSet = new Set(own.map((chapter) => chapter.n));

// Direct links crossing the part boundary, with the in-part chapters on each side.
const flow = crossingLinks(own, model.parts);
const sum = (pick: (chapter: (typeof own)[number]) => number): number =>
  own.reduce((total, chapter) => total + pick(chapter), 0);
const sectionsWritten = sum((chapter) => chapter.sectionsWritten);
const sectionsTotal = sum((chapter) => chapter.sections.length);
const totals = [
  `${String(sectionsWritten)} of ${String(sectionsTotal)} sections`,
  `${compactCount(sum((chapter) => chapter.words))} words`,
  `${String(sum((chapter) => chapter.figures))} figures`,
  `${String(sum((chapter) => chapter.equations))} equations`,
].join(' · ');
---

{part !== undefined && own.length > 0 && (
  <section class="pm" data-part-map data-domain={part.domain} aria-labelledby="pm-title">
    <p class="pm-head">
      <span class="pm-head__title" id="pm-title">
        Part {part.numeral}, as a flow
      </span>
      <span class="pm-head__note">point at a chapter or link</span>
    </p>
    <div class="pm-flow">
      <FlowSide
        side="in"
        label="Builds on"
        aria="Builds on, from earlier parts"
        none="No earlier chapter — this part opens the book."
        groups={flow.inGroups}
        chapters={byN}
      />

      <ol class="pm-tiles" role="list" data-pm-tiles>
        {own.map((chapter, index) => {
          const inPart = chapter.prereqs.filter((p) => ownSet.has(p));
          return (
            <li
              class:list={[
                'pm-tile',
                chapter.written ? 'is-written' : 'is-planned',
                { 'has-draft': !chapter.written && chapter.sectionsWritten > 0 },
              ]}
              data-pm-tile={chapter.n}
              data-pm-in={chapter.prereqs.join(' ')}
              data-pm-out={chapter.unlocks.join(' ')}
            >
              <a
                class="pm-tile__link"
                href={chapter.url}
                tabindex={index === 0 ? 0 : -1}
                aria-label={`${chapter.number} ${chapter.title}. ${chapter.state}. ${String(chapter.sectionsWritten)} of ${String(chapter.sections.length)} sections.`}
              >
                <span class="pm-tile__n">{chapter.number}</span>
                <span class="pm-tile__t">{chapter.title}</span>
              </a>
              <span class="pm-tile__cells">
                {chapter.sections.map((section) => (
                  <a
                    class:list={['pm-cell', section.written ? 'is-written' : 'is-planned']}
                    href={section.url}
                    tabindex="-1"
                    title={`${section.number} ${section.title}${section.written ? '' : ' · planned'}`}
                  >
                    <span class="sh-visually-hidden">
                      {section.number} {section.title}
                    </span>
                  </a>
                ))}
              </span>
              <span class="pm-tile__m">
                <span>{chapter.words > 0 ? `${compactCount(chapter.words)} words` : 'no words yet'}</span>
                {chapter.figures + chapter.equations > 0 && (
                  <span>{`${String(chapter.figures)} fig · ${String(chapter.equations)} eq`}</span>
                )}
              </span>
              <span class="pm-tile__in">
                {inPart.length === 0 ? (
                  <span class="pm-tile__root">entry point</span>
                ) : (
                  <>
                    <span class="pm-tile__via">builds on</span>
                    {inPart.map((p) => (
                      <span class="pm-tile__ref" data-pm-ref={p}>
                        {pad(p)}
                      </span>
                    ))}
                  </>
                )}
              </span>
            </li>
          );
        })}
      </ol>

      <FlowSide
        side="out"
        label="Unlocks"
        aria="Unlocks, in later parts"
        none="No later chapter lists this part yet."
        groups={flow.outGroups}
        chapters={byN}
      />
    </div>

    <div class="pm-readout" aria-live="polite" data-pm-readout>
      <p class="pm-readout__kicker" data-pm-kicker>
        Part {part.numeral} · {own.filter((chapter) => chapter.written).length} of {own.length} chapters written
      </p>
      <p class="pm-readout__title" data-pm-title>
        {totals}
      </p>
      <p class="pm-readout__body" data-pm-body>
        {flowSentence(flow, byN)}
      </p>
    </div>

    <script
      is:inline
      type="application/json"
      data-pm-data
      set:html={jsonForHtml(
        Object.fromEntries(
          own.map((chapter) => [
            chapter.n,
            {
              title: chapter.title,
              state: chapter.state,
              summary: chapter.summary === '' ? chapter.plan : chapter.summary,
              words: chapter.words,
              figures: chapter.figures,
              equations: chapter.equations,
              sections: `${String(chapter.sectionsWritten)}/${String(chapter.sections.length)}`,
            },
          ]),
        ),
      )}
    ></script>
  </section>
)}
