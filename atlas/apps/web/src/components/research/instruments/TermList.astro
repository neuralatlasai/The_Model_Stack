---
/**
 * Terms defined in the region. Each carries `data-term` so the client can
 * open the glossary entry in the rail inspector; without JS it jumps to the
 * definition on this page.
 */
import type { PageData, RailInstrument, ResearchDocument } from '@atlas/core';
import { termAnchor } from '@atlas/core';
import { instrumentAttrs, termAttrs } from '../lib/dom.ts';
import { findDefinition } from '../lib/walk.ts';
import InstrumentHead from './InstrumentHead.astro';

interface Props {
  instrument: Extract<RailInstrument, { kind: 'terms' }>;
  doc: ResearchDocument;
  pageData?: PageData | undefined;
}

const { instrument, doc, pageData } = Astro.props;
const terms = instrument.slugs.map((slug) => {
  const definition = findDefinition(doc, slug);
  const entry = pageData?.terms[slug];
  // Defined on this page: jump to it. Defined elsewhere: link to the owning page's definition.
  // Defined on this page: jump to it. Defined elsewhere: the owning page. Defined nowhere yet: plain text.
  const href = definition !== null && definition !== undefined ? `#${definition.anchor ?? termAnchor(slug)}` : (entry?.url ?? null);
  return {
    slug,
    term: definition?.term ?? entry?.term ?? slug,
    href,
  };
});
---

{
  terms.length > 0 && (
    <div class="rb-instrument rb-instrument--terms" {...instrumentAttrs('terms')}>
      <InstrumentHead title="Terms defined here" meta={String(terms.length)} />
      <ul class="rb-terms" role="list">
        {terms.map((term) => (
          <li>
            {term.href === null ? (
              <span class="rb-terms__link rb-terms__link--undefined" title="No glossary definition yet">
                {term.term}
              </span>
            ) : (
              <a class="rb-terms__link" href={term.href} {...termAttrs(term.slug)}>
                {term.term}
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}
