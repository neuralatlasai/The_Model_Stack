---
/**
 * Citation timeline for a chapter's references page: every cited work placed
 * on a date axis when complete dates are available over a short span, otherwise
 * a year axis. Types are marked (paper ●, technical report ◆, documentation
 * ■, repository ▲, other ○), with coincident sources stacked. Each mark links to
 * the work's paper page. The chapter's intellectual time-span at one glance —
 * unique per chapter, derived from its references table.
 */
import type { ReferenceRecord, ResearchDocument } from '@atlas/core';
import { href as siteHref } from './lib/site.ts';

interface Props {
  doc: ResearchDocument;
  references: readonly ReferenceRecord[];
}

const { doc, references } = Astro.props;
const chapter = doc.meta.chapter;
const cited = references.filter((record) => chapter !== null && record.uses.some((use) => use.chapter === chapter));

const yearOf = (record: ReferenceRecord): number | null => {
  const match = /\b(19[5-9]\d|20[0-4]\d)\b/u.exec(record.venue) ?? /\b(19[5-9]\d|20[0-4]\d)\b/u.exec(record.work);
  return match?.[1] === undefined ? null : Number(match[1]);
};
interface SourceDate {
  iso: string;
  time: number;
  year: number;
}
// Venues carry the inspected first-publication/release date. Do not substitute
// the inspection date, or manufacture a month/day from a year-only record.
const dateOf = (record: ReferenceRecord): SourceDate | null => {
  const match = /\b((?:19[5-9]\d|20[0-4]\d)-\d{2}-\d{2})\b/u.exec(record.venue);
  if (match === null || match[1] === undefined) return null;
  const iso = match[1];
  const prefix = record.venue.slice(0, match.index);
  if (/\b(?:inspect(?:ed|ion)?|accessed|updated|revis(?:ed|ion))\b/iu.test(prefix)) return null;
  const date = new Date(`${iso}T00:00:00Z`);
  if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0, 10) !== iso) return null;
  return { iso, time: date.getTime(), year: date.getUTCFullYear() };
};
type Mark = 'paper' | 'report' | 'doc' | 'repo' | 'other';
const markOf = (record: ReferenceRecord): Mark => {
  const type = record.type.toLowerCase();
  if (type.startsWith('paper')) return 'paper';
  if (type.includes('report')) return 'report';
  if (type.includes('documentation') || type.includes('card') || type.includes('course')) return 'doc';
  if (type.includes('repository')) return 'repo';
  return 'other';
};
const GLYPH: Readonly<Record<Mark, string>> = { paper: '●', report: '◆', doc: '■', repo: '▲', other: '○' };
const LABEL: Readonly<Record<Mark, string>> = {
  paper: 'paper',
  report: 'technical report',
  doc: 'documentation / card',
  repo: 'repository',
  other: 'other',
};

const dated = cited
  .map((record) => ({ record, year: yearOf(record), date: dateOf(record), mark: markOf(record) }))
  .filter(
    (entry): entry is { record: ReferenceRecord; year: number; date: SourceDate | null; mark: Mark } =>
      entry.year !== null,
  )
  .sort((a, b) => a.year - b.year || a.record.key.localeCompare(b.record.key));
const years = dated.map((entry) => entry.year);
const minYear = years.length > 0 ? Math.min(...years) : 0;
const maxYear = years.length > 0 ? Math.max(...years) : 0;
const completeDates = dated.length > 1 && dated.every((entry) => entry.date !== null && entry.date.year === entry.year);
const times = dated.flatMap((entry) => (entry.date === null ? [] : [entry.date.time]));
const minTime = times.length > 0 ? Math.min(...times) : 0;
const maxTime = times.length > 0 ? Math.max(...times) : 0;
const twoYearsLater = new Date(minTime);
twoYearsLater.setUTCFullYear(twoYearsLater.getUTCFullYear() + 2);
const dateAxis = completeDates && maxTime <= twoYearsLater.getTime();
const axisMin = dateAxis ? minTime : minYear;
const axisMax = dateAxis ? maxTime : maxYear;
const span = Math.max(1, axisMax - axisMin);
const fraction = (value: number): number => (axisMin === axisMax ? 0.5 : (value - axisMin) / span);
const pct = (value: number): string => `${String(fraction(value) * 100)}%`;
const grouped = new Map<number, typeof dated>();
for (const entry of dated) {
  const position = dateAxis && entry.date !== null ? entry.date.time : entry.year;
  grouped.set(position, [...(grouped.get(position) ?? []), entry]);
}
const columns = [...grouped.entries()]
  .sort(([a], [b]) => a - b)
  .map(([position, entries]) => ({ position, entries, lane: 0 }));
// Adjacent release dates can have overlapping 18px hit targets on mobile.
// Keep their true horizontal position and offset the stacks vertically. The
// conservative 260px plot width also covers a 320px phone with page gutters.
for (const [index, column] of columns.entries()) {
  if (!dateAxis) continue;
  const neighbours = columns
    .slice(0, index)
    .filter((other) => fraction(column.position) - fraction(other.position) < 18 / 260);
  while (
    neighbours.some(
      (other) => column.lane < other.lane + other.entries.length && other.lane < column.lane + column.entries.length,
    )
  ) {
    column.lane += 1;
  }
}
const stackRows = Math.max(0, ...columns.map((column) => column.lane + column.entries.length));
const plotHeight = stackRows * 16 + 8;
const monthLabel = (time: number): string =>
  new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(time);
const sameMonth = dateAxis && monthLabel(axisMin) === monthLabel(axisMax);
const dateLabel = (time: number): string =>
  new Intl.DateTimeFormat('en', {
    ...(sameMonth ? { day: 'numeric' as const } : {}),
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(time);
const candidates: number[] = [];
if (dateAxis) {
  const month = new Date(axisMin);
  month.setUTCDate(1);
  month.setUTCMonth(month.getUTCMonth() + 1);
  while (month.getTime() < axisMax) {
    candidates.push(month.getTime());
    month.setUTCMonth(month.getUTCMonth() + 1);
  }
} else {
  candidates.push(...[...grouped.keys()].filter((year) => year % 5 === 0).sort((a, b) => a - b));
}
// Sparse labels remain legible at the 358px mobile manuscript width; source
// marks themselves are never omitted. Edge labels stay inside the plot.
const tickPositions = [axisMin];
const labelGap = dateAxis ? 0.22 : 0.15;
for (const value of candidates) {
  if ((value - (tickPositions.at(-1) ?? axisMin)) / span >= labelGap && (axisMax - value) / span >= labelGap)
    tickPositions.push(value);
}
if (axisMax !== axisMin) tickPositions.push(axisMax);
const rangeLabel = dateAxis
  ? sameMonth
    ? monthLabel(axisMin)
    : `${monthLabel(axisMin)}–${monthLabel(axisMax)}`
  : `${minYear}–${maxYear}`;
const marks = [...new Set(dated.map((entry) => entry.mark))];
const undated = cited.length - dated.length;
---

{dated.length > 1 && (
  <figure class="rb-ctl" aria-labelledby="ctl-title" data-axis={dateAxis ? 'date' : 'year'}>
    <figcaption class="rb-ctl__head" id="ctl-title">
      <span class="rb-ctl__kicker">Sources in time</span>
      <span class="rb-ctl__note">
        {dated.length} dated works, {rangeLabel}
        {undated > 0 ? ` · ${String(undated)} undated` : ''}
      </span>
    </figcaption>
    <div class="rb-ctl__plot" style={`--citation-stack-height: ${String(plotHeight)}px`}>
      {columns.map(({ position, entries, lane }) => (
        <div class="rb-ctl__col" style={`--x: ${pct(position)}; inset-block-end: ${String(2 + lane * 16)}px`}>
          {entries.map((entry) => (
            <a
              class={`rb-ctl__mark rb-ctl__mark--${entry.mark}`}
              href={siteHref(entry.record.atlasUrl)}
              title={`${entry.record.key} · ${entry.record.work} (${dateAxis && entry.date !== null ? entry.date.iso : String(entry.year)})`}
              aria-label={`${entry.record.key}: ${entry.record.work}, ${dateAxis && entry.date !== null ? entry.date.iso : String(entry.year)}`}
            >
              <span aria-hidden="true">{GLYPH[entry.mark]}</span>
            </a>
          ))}
        </div>
      ))}
      <div class="rb-ctl__axis" aria-hidden="true">
        {tickPositions.map((position, index) => (
          <span
            class="rb-ctl__tick"
            style={`--x: ${pct(position)}; white-space: nowrap${dateAxis && axisMin !== axisMax && (index === 0 || index === tickPositions.length - 1) ? `; translate: ${index === 0 ? '0' : '-100%'} 0` : ''}`}
          >
            {dateAxis ? dateLabel(position) : position}
          </span>
        ))}
      </div>
    </div>
    <ul class="rb-ctl__legend" role="list">
      {marks.map((mark) => (
        <li>
          <span class={`rb-ctl__glyph rb-ctl__mark--${mark}`} aria-hidden="true">
            {GLYPH[mark]}
          </span>
          {LABEL[mark]}
        </li>
      ))}
    </ul>
  </figure>
)}
