---
/**
 * A sequence of research blocks. Nested containers (list items, quotes,
 * expansions, proofs, experiment fields) render their children through here.
 */
import type { Block as BlockNode } from '@atlas/core';
import Block from './Block.astro';
import MathProcedure from './MathProcedure.astro';
import { groupMathProcedures } from './lib/math-procedures.ts';

interface Props {
  blocks: readonly BlockNode[];
}

const { blocks } = Astro.props;
---

{(Astro.locals.mathProcedurePlates === true ? groupMathProcedures(blocks) : blocks).map((item) =>
  item.kind === 'math-procedure' ? <MathProcedure procedure={item} /> : <Block block={item} />,
)}
