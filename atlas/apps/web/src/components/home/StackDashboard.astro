---
/** One connected atlas: brain regions, part stations and their chapter populations. */
import type { Brain3D } from '../../lib/brain3d.ts';
import type { BrainModel } from '../../lib/brain-map.ts';
import { CHAPTER_ICON } from '../../lib/chapter-icons.ts';
import { jsonForHtml } from '../../lib/json.ts';
import type { Dashboard } from '../../lib/stack-dashboard.ts';
import BrainHero from './BrainHero.astro';
import ChapterSymbol from '../shell/ChapterSymbol.astro';
interface Props {
  brain: BrainModel;
  brain3d: Brain3D;
  dash: Dashboard;
}
const { brain, brain3d, dash } = Astro.props;
const states = new Map(dash.status.map((chapter) => [chapter.n, chapter.state]));
const chapterPart = new Map(brain.neurons.map((chapter) => [chapter.n, chapter.part]));
const navigation = (state: Dashboard['overview']) => ({
  part: state.part,
  badge: state.badge,
  range: state.range,
  status: `${state.tiles.filter((chapter) => states.get(chapter.n) === 'written').length} of ${state.tiles.length} chapters written`,
  chapters: state.chapters,
});
let completed = 0;
const stations = brain.regions.map((part, i) => {
  const chapters = dash.parts.find((state) => state.part === part.n)?.tiles ?? [];
  completed += chapters.reduce((sum, chapter) => sum + Math.max(0, Math.min(1, chapter.fill)), 0);
  return {
    ...part,
    x: 36 + i * 52.8,
    y: 58 - (completed / dash.status.length) * 44,
    chapters,
    icon: CHAPTER_ICON[chapters[0]?.n ?? 1],
  };
});
const edges = [...new Set(brain.fibres.map((edge) => `${chapterPart.get(edge.from)}:${chapterPart.get(edge.to)}`))]
  .map((edge) => edge.split(':').map(Number))
  .filter(([from, to]) => from !== to)
  .map(([from, to]) => ({ from: stations.find((part) => part.n === from), to: stations.find((part) => part.n === to) }))
  .filter((edge) => edge.from && edge.to);
const progressPath = stations.map((part, i) => `${i === 0 ? 'M' : 'L'}${part.x} ${part.y}`).join(' ');
---

<aside class="dx" data-dash aria-label="Explore the model stack">
  <script
    type="application/json"
    data-dash-data
    set:html={jsonForHtml({
      overview: navigation(dash.overview),
      parts: dash.parts.map(navigation),
      edges: brain.fibres.map((edge) => [edge.from, edge.to]),
    })}
  ></script>
  <div class="dx-field">
    <div class="dx-halftone" aria-hidden="true"></div>
    <p class="dx-badge" data-dx-badge>
      {dash.overview.badge}
    </p>
    <p class="dx-range" data-dx-range>
      {dash.overview.range}
    </p>
    <div class="dx-brain">
      <BrainHero brain={brain} brain3d={brain3d} />
    </div>
  </div>
  <svg class="dx-tether" data-region-tether aria-hidden="true">
    <path data-region-tether-path></path>
    <circle data-region-tether-origin r="3.5"></circle>
  </svg>
  <nav class="dx-map" aria-label="Connected part and chapter map">
    <p class="dx-map__caption">
      <span data-map-status role="status">
        Select a part to trace its chapters and prerequisites.
      </span>
    </p>
    <svg
      class="dx-map__progress"
      viewBox="0 0 600 224"
      role="group"
      aria-label="Manuscript completion across eleven parts, connected to their chapters"
    >
      <title>Each station is a book part. The red spine accumulates chapter completion fractions in book order, divided by all 66 chapters. Select a station to trace prerequisites and open its chapters. Animated pulses follow the brain's declared prerequisite connections; they illustrate dependency direction. The chart measures manuscript completion, not elapsed time, a forecast or live compute telemetry.</title>
      <defs>
        <marker
          id="dx-prerequisite-arrow"
          viewBox="0 0 7 7"
          refX="6"
          refY="3.5"
          markerWidth="7"
          markerHeight="7"
          markerUnits="userSpaceOnUse"
          orient="auto"
        >
          <path d="M1 1L6 3.5L1 6" fill="none" stroke="var(--accent)" />
        </marker>
      </defs>
      <path d="M36 60H564" class="dx-map__baseline" />
      <path d={progressPath} class="dx-map__completion" />
      <g class="dx-map__network">
        {edges.map(
          ({ from, to }) =>
            from &&
            to && (
              <path
                class="dx-map__edge"
                data-from={from.n}
                data-to={to.n}
                marker-end="url(#dx-prerequisite-arrow)"
                d={`M${from.x + (from.x < to.x ? 20 : -20)} 82Q${(from.x + to.x) / 2} ${82 - Math.min(56, Math.abs(from.x - to.x) * 0.13)} ${to.x + (from.x < to.x ? -20 : 20)} 82`}
              />
            ),
        )}
      </g>
      {stations.map((part) => (
        <a href={part.url} data-map-part={part.n} aria-label={`Explore ${part.title}`}>
          <title>{`${part.title}. ${navigation(dash.parts.find((state) => state.part === part.n) ?? dash.overview).status}`}</title>
          <rect class="dx-map__hit" x={part.x - 23} y={part.y - 14} width="46" height={110 - part.y} rx="3" />
          <path class="dx-map__leader" d={`M${part.x} ${part.y + 4}V70`} />
          <circle class="dx-map__point" cx={part.x} cy={part.y} r="3.4" />
          <g transform={`translate(${part.x - 10} 72) scale(.8333)`}>
            <g class="dx-map__symbol">
              <Fragment set:html={part.icon} />
            </g>
          </g>
        </a>
      ))}
      <g data-map-overview aria-hidden="true">
        {stations.map((part) => (
          <g data-population-part={part.n}>
            <path class="dx-map__population-spine" d={`M${part.x} 104V193`} />
            {part.chapters.map((chapter, i) => (
              <circle
                class:list={[
                  'dx-map__population',
                  {
                    'is-written': states.get(chapter.n) === 'written',
                    'is-progress': states.get(chapter.n) === 'progress',
                  },
                ]}
                cx={part.x}
                cy={115 + i * 15}
                r="3.6"
              />
            ))}
          </g>
        ))}
      </g>
      {stations.map((part) => (
        <g data-map-chapters={part.n} style="display:none">
          {part.chapters.map((_, i) => (
            <path class="dx-map__fan" d={`M${part.x} 104C${part.x} 145 ${50 + i * 100} 135 ${50 + i * 100} 178`} />
          ))}
          {part.chapters.map((chapter, i) => (
            <a
              href={chapter.url}
              data-map-chapter={chapter.n}
              data-state={states.get(chapter.n)}
              aria-label={`${chapter.label}; ${states.get(chapter.n)}`}
            >
              <title>{`${chapter.label}; ${states.get(chapter.n)}`}</title>
              <rect class="dx-map__chapter-hit" x={27 + i * 100} y="172" width="46" height="46" rx="3" />
              <g transform={`translate(${38 + i * 100} 183)`}>
                <g class="dx-map__chapter-symbol">
                  <Fragment set:html={CHAPTER_ICON[chapter.n]} />
                </g>
              </g>
              <circle class="dx-map__chapter-state" cx={50 + i * 100} cy="214" r="2" />
            </a>
          ))}
        </g>
      ))}
    </svg>
  </nav>
  <details class="dx-catalog">
    <summary aria-label="Show or hide all chapter symbols" title="All chapters">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 3h4v4H3zM10 3h4v4h-4zM17 3h4v4h-4zM3 10h4v4H3zM10 10h4v4h-4zM17 10h4v4h-4zM3 17h4v4H3zM10 17h4v4h-4zM17 17h4v4h-4z" />
      </svg>
    </summary>
    <nav class="dx-catalog__grid" aria-label="All 66 chapters">
      {stations.map((part) => (
        <div class="dx-catalog__part" data-catalog-part={part.n} role="group" aria-label={part.title}>
          <span class="dx-catalog__branch" aria-hidden="true"></span>
          {part.chapters.map((chapter) => (
            <a
              href={chapter.url}
              data-map-chapter={chapter.n}
              data-state={states.get(chapter.n)}
              title={`${chapter.label}; ${states.get(chapter.n)}`}
              aria-label={`${chapter.label}; ${states.get(chapter.n)}`}
            >
              <ChapterSymbol chapter={chapter.n} />
              <i aria-hidden="true"></i>
            </a>
          ))}
        </div>
      ))}
    </nav>
  </details>
</aside>
