---
/**
 * The home page's product story, above the existing atlas instruments:
 *
 *   hero        what the atlas is and why it is useful, beside the book as a
 *               brain (BrainHero.astro): chapters as neurons, concepts, fibres
 *   01 evidence every claim carries its evidence label — real claims cycle
 *   02 connected a written chapter with what it builds on and what it unlocks
 *   03 depth    one text, four depths — the section anatomy by depth
 *   04 search   real results from the site's own index for a few queries
 *   05 sources  cited works by status; the 2026 evaluation ecosystem
 *   06 how      manuscript → compiler → graph → atlas, with real counts
 *
 * Every number and example comes from the compiled bundle (lib/home-model.ts).
 * Behaviour (client home.ts) is progressive: without JavaScript every section
 * renders its first state and every element is a working link.
 */
import type { AtlasGraph, BundleManifest, NodeId, Registry } from '@atlas/core';
import { DOMAINS as ECO_DOMAINS, ecosystem } from '../../lib/eval-ecosystem.ts';
import { grouped } from '../../lib/format.ts';
import { jsonForHtml } from '../../lib/json.ts';
import type { BrainModel } from '../../lib/brain-map.ts';
import type { Brain3D } from '../../lib/brain3d.ts';
import type { HomeClaim, HomeFocus, HomeModel } from '../../lib/home-model.ts';
import BrainHero from './BrainHero.astro';

interface Props {
  model: HomeModel;
  brain: BrainModel;
  brain3d: Brain3D;
  globe: unknown;
  galaxy: unknown;
  graph: AtlasGraph;
  registry: Registry;
  manifest: BundleManifest;
  startUrl: string;
  edges: number;
}

const { model, brain, brain3d, globe, galaxy, graph, registry, manifest, startUrl, edges } = Astro.props;
const chapterTotal = brain.neurons.length;

const CLASS_LABEL: Readonly<Record<string, string>> = { source: 'cited source', inference: "the book's inference", gap: 'evidence missing', measurement: 'executed check' };
const labelTotal = model.labels.reduce((sum, entry) => sum + entry.count, 0);
const claimFor = (label: string): number => model.claims.findIndex((claim: HomeClaim) => claim.label === label);

const STATUS = [
  { key: 'peer-reviewed', label: 'peer-reviewed', cls: 'peer' },
  { key: 'preprint', label: 'preprint', cls: 'pre' },
  { key: 'official documentation', label: 'official documentation', cls: 'doc' },
  { key: 'UNVERIFIED', label: 'unverified', cls: 'unv' },
] as const;
const statusCounts = STATUS.map((status) => ({ ...status, count: registry.references.filter((record) => record.status === status.key).length }));
const otherStatus = registry.references.length - statusCounts.reduce((sum, status) => sum + status.count, 0);
const eco = ecosystem();
const ecoDomain = new Map(ECO_DOMAINS.map((domain) => [domain.key, domain.short]));
const nodeCount = Object.keys(graph.nodes).length;
const appendix = graph.nodes['ms.appendix.i' as NodeId] ?? null;
const pad2 = (text: string): string => text.padStart(2, '0');
const focus: readonly HomeFocus[] = model.focus;
---

<section class="hx-hero" aria-labelledby="hx-title" data-home-hero>
  <div class="hx-hero__text">
    <p class="hx-eyebrow">Research Atlas · Edition {manifest.edition}</p>
    <h1 class="hx-title" id="hx-title">The Model Stack</h1>
    <p class="hx-value">How modern AI models are built — from data and silicon to deployed intelligence — in one connected, evidence-labelled atlas.</p>
    <p class="hx-support">
      Sixty-six chapters follow a model through its whole life: data, architecture, training, hardware, post-training, inference, serving, agents, multimodality, and evaluation. Every
      claim says what supports it; every chapter says what it builds on.
    </p>
    <div class="hx-actions">
      <a class="hx-btn hx-btn--primary" href={startUrl}>Start reading <span aria-hidden="true">→</span></a>
      <a class="hx-btn" href="#stack-map">Explore the map</a>
    </div>
    <a class="hx-news" href="/evaluation-ecosystem/">
      <span class="hx-news__tag">New</span>
      <span class="hx-news__t">The 2026 evaluation ecosystem: 100 systems, ranked and checked</span>
      <span class="hx-news__go" aria-hidden="true">→</span>
    </a>
  </div>

  <BrainHero brain={brain} brain3d={brain3d} />
</section>

<p class="hx-scale">
  {grouped(chapterTotal)} chapters · {grouped(brain.regions.length)} parts · {grouped(manifest.counts.figures)} figures · {grouped(manifest.counts.equations)} equations · {grouped(manifest.counts.references)} references · {grouped(manifest.counts.terms)} terms
</p>

<!-- 01 · evidence ------------------------------------------------------------ -->
<section class="hx-sec hx-sec--split" aria-labelledby="hx-ev-title" data-reveal>
  <div class="hx-sec__text">
    <p class="hx-kicker"><span>01</span> Evidence first</p>
    <h2 class="hx-h2" id="hx-ev-title">Every claim says what supports it.</h2>
    <p class="hx-lede">
      What is known about model systems is scattered across papers, repositories, model cards, and vendor documentation of very different reliability. The atlas labels each technical
      statement — reported by a paper, documented by a vendor, derived by the book, or not disclosed — so you can see how far to trust it before you build on it.
    </p>
    <ul class="hx-points" role="list">
      <li>Nothing is presented as measured unless it was.</li>
      <li>Undisclosed internals are marked, never guessed.</li>
      <li>Every citation resolves to a source page with its verification status.</li>
    </ul>
    <a class="hx-link" href="/evidence/">How the evidence labels work <span aria-hidden="true">→</span></a>
  </div>

  <div class="hx-panel hx-claims" data-home-claims data-tilt>
    <p class="hx-panel__head"><span>From the manuscripts</span><span>{grouped(labelTotal)} labelled statements</span></p>
    <div class="hx-claims__stage">
      {
        model.claims.map((claim, index) => (
          <article class={`hx-claim ev-${claim.cls}`} data-claim={index} hidden={index !== 0}>
            <p class="hx-claim__label">
              <span class="hx-chip">{claim.label}</span>
              <span class="hx-claim__cls">{CLASS_LABEL[claim.cls]}</span>
            </p>
            <blockquote class="hx-claim__text">{claim.text}</blockquote>
            <p class="hx-claim__src">
              <a href={claim.url}>{claim.where} →</a>
              {claim.cites.map((key) => {
                const work = registry.references.find((record) => record.key === key);
                return work === undefined ? null : (
                  <a class="hx-cite" href={work.atlasUrl} title={work.work}>
                    {key}
                  </a>
                );
              })}
            </p>
          </article>
        ))
      }
    </div>
    <div class="hx-claims__labels" role="group" aria-label="Evidence labels in the manuscripts">
      {
        model.labels.map((entry) => {
          const target = claimFor(entry.label);
          return (
            <button type="button" class={`hx-lab ev-${entry.cls}`} data-claim-target={target} disabled={target === -1} aria-pressed={target === 0 ? 'true' : 'false'}>
              <i aria-hidden="true" />
              {entry.label.toLowerCase().replaceAll('-', ' ')}
              <span>{grouped(entry.count)}</span>
            </button>
          );
        })
      }
    </div>
    <div class="hx-dots" aria-hidden="true">
      {model.claims.map((_, index) => <i class:list={{ 'is-on': index === 0 }} data-dot={index} />)}
    </div>
  </div>
</section>

<!-- 02 · connected ----------------------------------------------------------- -->
{
  focus.length > 0 && (
    <section class="hx-sec hx-sec--split hx-sec--flip" aria-labelledby="hx-dep-title" data-reveal>
      <div class="hx-sec__text">
        <p class="hx-kicker">
          <span>02</span> Connected
        </p>
        <h2 class="hx-h2" id="hx-dep-title">
          Every chapter knows what it builds on.
        </h2>
        <p class="hx-lede">
          Prerequisites are declared, not implied. Follow a mechanism back to its foundations, or forward to the systems that depend on it — across all {chapterTotal} chapters and{' '}
          {grouped(edges)} dependency links.
        </p>
        <div class="hx-tabs" role="tablist" aria-label="Example chapters">
          {focus.map((chapter, index) => (
            <button type="button" role="tab" class="hx-tab" data-focus-tab={index} data-focus-n={Number.parseInt(chapter.number, 10)} aria-selected={index === 0 ? 'true' : 'false'}>
              <b>{pad2(chapter.number)}</b> {chapter.title}
            </button>
          ))}
        </div>
        <a class="hx-link" href="#stack-map">
          Open the full map <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="hx-panel hx-deps" data-home-deps>
        <script type="application/json" data-globe set:html={jsonForHtml(globe)} />
        <div class="hg" data-globe-host>
          <div class="hg-labels" data-globe-labels aria-hidden="true" />
        </div>
        <p class="hg-cap" data-globe-cap aria-live="polite" />
        <p class="hg-legend" aria-hidden="true">
          <span><i class="is-in" />builds on</span>
          <span><i class="is-out" />unlocks</span>
          <span><i class="is-node" />chapter, filled when written</span>
          <span>drag to spin · click a chapter to open it</span>
        </p>
        <p class="hx-panel__head">
          <span>builds on</span>
          <span>unlocks</span>
        </p>
        {focus.map((chapter, index) => (
          <div class="hx-dep" data-focus={index} hidden={index !== 0}>
            <svg class="hx-dep__wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              {chapter.prereqs.map((_, i) => (
                <path class="hx-wire hx-wire--in" pathLength="1" d={`M26 ${String(((i + 0.5) / chapter.prereqs.length) * 100)} C 32 ${String(((i + 0.5) / chapter.prereqs.length) * 100)}, 30 50, 36 50`} />
              ))}
              {chapter.unlocks.map((_, i) => (
                <path class="hx-wire hx-wire--out" pathLength="1" d={`M64 50 C 70 50, 68 ${String(((i + 0.5) / chapter.unlocks.length) * 100)}, 74 ${String(((i + 0.5) / chapter.unlocks.length) * 100)}`} />
              ))}
            </svg>
            <ol class="hx-dep__col" role="list" aria-label="Builds on">
              {chapter.prereqs.map((ref) => (
                <li>
                  <a class:list={['hx-node', { 'is-planned': !ref.written }]} href={ref.url}>
                    <b>{pad2(ref.number)}</b>
                    <span class="hx-node__t">{ref.title}</span>
                  </a>
                </li>
              ))}
            </ol>
            <a class="hx-node hx-node--focus" href={chapter.url}>
              <b>Chapter {pad2(chapter.number)}</b>
              <span class="hx-node__t">{chapter.title}</span>
            </a>
            <ol class="hx-dep__col" role="list" aria-label="Unlocks">
              {chapter.unlocks.map((ref) => (
                <li>
                  <a class:list={['hx-node', { 'is-planned': !ref.written }]} href={ref.url}>
                    <b>{pad2(ref.number)}</b>
                    <span class="hx-node__t">{ref.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
        <p class="hx-deps__legend">
          <i class="is-written" /> written <i class="is-planned" /> planned
        </p>
      </div>
    </section>
  )
}

<!-- 03 · depth --------------------------------------------------------------- -->
<section class="hx-sec hx-sec--split" aria-labelledby="hx-depth-title" data-reveal>
  <div class="hx-sec__text">
    <p class="hx-kicker"><span>03</span> Read at your depth</p>
    <h2 class="hx-h2" id="hx-depth-title">One text, four depths.</h2>
    <p class="hx-lede">
      Every section is written once and read at the depth you need. Overview keeps the argument and the principal diagrams; each deeper layer adds formulation, then evidence and
      failure modes, then implementation and reproducibility. The setting follows you from page to page.
    </p>
  </div>

  <div class="hx-panel hx-depth" data-home-depth data-depth="technical">
    <div class="hx-seg" role="radiogroup" aria-label="Reading depth">
      {
        model.depths.map((depth) => (
          <button type="button" role="radio" class="hx-seg__opt" data-depth-opt={depth.key} aria-checked={depth.key === 'technical' ? 'true' : 'false'}>
            {depth.label}
          </button>
        ))
      }
    </div>
    <p class="hx-depth__desc" data-depth-desc aria-live="polite">{model.depths.find((depth) => depth.key === 'technical')?.description}</p>
    <div class="hx-depth3d" aria-hidden="true">
      <div class="hx-stack3d">
        {
          model.depths.map((depth, index) => (
            <div class={`hx-plane hx-plane--${depth.key}`} style={`--k:${String(index)}`}>
              <span class="hx-plane__name">{depth.label}</span>
              <span class="hx-plane__rows">
                {model.anatomy
                  .filter((row) => row.depth === depth.key)
                  .map((row) => row.label)
                  .join(' · ')}
              </span>
            </div>
          ))
        }
      </div>
    </div>
    <ol class="hx-anatomy sh-visually-hidden" role="list">
      {
        model.anatomy.map((row) => (
          <li class={`hx-anat hx-anat--${row.depth}`} data-anat={row.depth}>
            <span class="hx-anat__bar" aria-hidden="true" />
            <span class="hx-anat__label">{row.label}</span>
            <span class="hx-anat__depth">{model.depths.find((depth) => depth.key === row.depth)?.label}</span>
          </li>
        ))
      }
    </ol>
    <script type="application/json" data-depth-desc-data set:html={jsonForHtml(Object.fromEntries(model.depths.map((depth) => [depth.key, depth.description])))} />
  </div>
</section>

<!-- 04 · search -------------------------------------------------------------- -->
{
  model.searches.length > 0 && (
    <section class="hx-sec hx-sec--split hx-sec--flip" aria-labelledby="hx-search-title" data-reveal>
      <div class="hx-sec__text">
        <p class="hx-kicker">
          <span>04</span> Find anything
        </p>
        <h2 class="hx-h2" id="hx-search-title">
          Anything in the book, one keystroke away.
        </h2>
        <p class="hx-lede">
          Chapters, sections, equations, figures, papers, and terms share one index of {grouped(manifest.counts.searchDocs)} objects. Press <kbd>Ctrl</kbd> <kbd>K</kbd> on any page.
        </p>
        <button type="button" class="hx-btn" data-home-open-search>
          Try the search <span aria-hidden="true">→</span>
        </button>
      </div>

      <div class="hx-panel hx-palette" data-home-search data-tilt>
        <script type="application/json" data-galaxy set:html={jsonForHtml(galaxy)} />
        <div class="hy" data-galaxy-host>
          <div class="hy-labels" data-galaxy-labels aria-hidden="true" />
        </div>
        <div class="hx-palette__input">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path d="m10.4 10.4 3.4 3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          <span class="hx-palette__query" data-query>{model.searches[0]?.query}</span>
          <span class="hx-caret" aria-hidden="true" />
          <kbd>Ctrl K</kbd>
        </div>
        {model.searches.map((search, index) => (
          <ol class="hx-palette__results" role="list" data-results={index} data-q={search.query} hidden={index !== 0}>
            {search.results.map((result) => (
              <li>
                <a class="hx-hit" href={result.url}>
                  <span class="hx-hit__kind">{result.kind}</span>
                  <span class="hx-hit__title">{result.title}</span>
                  <span class="hx-hit__ctx">{result.context}</span>
                </a>
              </li>
            ))}
          </ol>
        ))}
      </div>
    </section>
  )
}

<!-- 05 · sources ------------------------------------------------------------- -->
<section class="hx-sec hx-sec--split" aria-labelledby="hx-src-title" data-reveal>
  <div class="hx-sec__text">
    <p class="hx-kicker"><span>05</span> Checked sources</p>
    <h2 class="hx-h2" id="hx-src-title">Sources and benchmarks, checked at their origin.</h2>
    <p class="hx-lede">
      {grouped(registry.references.length)} cited works carry their venue and verification status. {registry.systems.length} systems and {registry.labs.length} labs are placed in the
      stack. The 100 evaluation systems that matter in 2026 are ranked, linked to where they live, and checked against their own sites.
    </p>
    <p class="hx-inline-links">
      <a href="/papers/">Papers</a>
      <a href="/systems/">Systems</a>
      <a href="/labs/">Labs</a>
      <a href="/evaluation-ecosystem/">Evaluation ecosystem</a>
      {appendix !== null && <a href={appendix.url}>Appendix I</a>}
    </p>
  </div>

  <div class="hx-panel hx-sources" data-home-sources>
    <p class="hx-panel__head"><span>Cited works by status</span><span>{grouped(registry.references.length)}</span></p>
    <div class="hx-statusbar">
      {
        statusCounts
          .filter((status) => status.count > 0)
          .map((status) => (
            <a
              class={`hx-status hx-status--${status.cls}`}
              style={`flex-grow:${String(status.count)}`}
              href="/papers/"
              title={`${String(status.count)} ${status.label}`}
            >
              <span>{status.count}</span>
            </a>
          ))
      }
      {otherStatus > 0 && <span class="hx-status hx-status--other" style={`flex-grow:${String(otherStatus)}`} title={`${String(otherStatus)} other`} />}
    </div>
    <p class="hx-statuslegend">
      {
        statusCounts
          .filter((status) => status.count > 0)
          .map((status) => (
            <span>
              <i class={`hx-status--${status.cls}`} />
              {status.label}
            </span>
          ))
      }
    </p>

    <p class="hx-panel__head hx-panel__head--gap">
      <span>Evaluation ecosystem, 2026</span>
      <span data-eco-name>100 systems · point to name one</span>
    </p>
    <div class="hx-eco3d">
    <ol class="hx-eco" role="list" aria-label="The 100 evaluation systems in priority order">
      {
        eco.entries.map((entry) => (
          <li>
            <a
              class={`hx-eco__cell eco-d--${entry.domain}`}
              href={`/evaluation-ecosystem/#eco-${String(entry.rank)}`}
              data-eco-label={`${String(entry.rank)} · ${entry.name} · ${ecoDomain.get(entry.domain) ?? entry.domain}`}
              aria-label={`${String(entry.rank)}. ${entry.name}`}
              tabindex="-1"
            />
          </li>
        ))
      }
    </ol>
    </div>
    <p class="hx-statuslegend">
      {
        ECO_DOMAINS.map((domain) => (
          <span class={`eco-d--${domain.key}`}>
            <i class="hx-eco__key" />
            {domain.short}
          </span>
        ))
      }
    </p>
    <a class="hx-link" href="/evaluation-ecosystem/">Open the evaluation ecosystem <span aria-hidden="true">→</span></a>
  </div>
</section>

<!-- 06 · how it works -------------------------------------------------------- -->
<section class="hx-sec hx-how" aria-labelledby="hx-how-title" data-reveal>
  <div class="hx-how__head">
    <p class="hx-kicker"><span>06</span> How it works</p>
    <h2 class="hx-h2" id="hx-how-title">From manuscript to instrument.</h2>
    <p class="hx-lede">The atlas is compiled, not hand-assembled: one source of truth, checked on every build, so the book, the maps, and the search never disagree.</p>
  </div>
  <ol class="hx-steps" role="list">
    <li class="hx-step" style="--s:0">
      <a class="hx-step__link" href="/library/">
        <span class="hx-step__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z M14 3v4h4 M9 12h6 M9 15.5h6 M9 9h3" /></svg>
        </span>
        <p class="hx-step__n">1 · Write</p>
        <p class="hx-step__t">Chapters are Markdown with typed frontmatter: ids, prerequisites, evidence labels, and sources.</p>
        <p class="hx-step__m">{grouped(manifest.counts.documents)} manuscripts</p>
      </a>
    </li>
    <li class="hx-step" style="--s:1">
      <a class="hx-step__link" href="/evidence/">
        <span class="hx-step__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6z M8.8 12.2l2.2 2.2 4.4-4.6" /></svg>
        </span>
        <p class="hx-step__n">2 · Compile</p>
        <p class="hx-step__t">A strict compiler checks every label, link, citation, and figure specification before anything is published.</p>
        <p class="hx-step__m">{grouped(manifest.counts.figures)} figures · {grouped(manifest.counts.equations)} equations</p>
      </a>
    </li>
    <li class="hx-step" style="--s:2">
      <a class="hx-step__link" href="/graph/">
        <span class="hx-step__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M6 6.5a2 2 0 1 0 0 .01 M18 6.5a2 2 0 1 0 0 .01 M12 17.5a2 2 0 1 0 0 .01 M7.6 7.6l3 8 M16.4 7.6l-3 8 M8 6.5h8" /></svg>
        </span>
        <p class="hx-step__n">3 · Connect</p>
        <p class="hx-step__t">Sections, papers, systems, labs, and terms become one typed graph of prerequisites and uses.</p>
        <p class="hx-step__m">{grouped(nodeCount)} nodes · {grouped(graph.edges.length)} edges</p>
      </a>
    </li>
    <li class="hx-step" style="--s:3">
      <a class="hx-step__link" href="#stack-map">
        <span class="hx-step__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M3.5 5.5h17v13h-17z M3.5 9h17 M7 13h4 M7 15.5h7 M15 12.5h2.5v3.5H15z" /></svg>
        </span>
        <p class="hx-step__n">4 · Explore</p>
        <p class="hx-step__t">Maps, instruments, and search are generated from that graph and update with every chapter.</p>
        <p class="hx-step__m">{grouped(manifest.counts.searchDocs)} searchable objects</p>
      </a>
    </li>
  </ol>
</section>

<div class="hx-bridge" data-reveal>
  <p class="hx-kicker"><span>07</span> Explore</p>
  <p class="hx-bridge__t">The whole book, live below — the dependency map, the lineage of ideas, and every chapter.</p>
</div>
