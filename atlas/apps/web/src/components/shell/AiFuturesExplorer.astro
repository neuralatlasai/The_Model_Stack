---
/**
 * AI futures (lib/ai-futures.ts) as one field panel, two charts, and the index.
 *
 *   panel     the supplier's fit down the ranking as one thick line with a
 *             halftone band; the readout in the space the line leaves; one
 *             row of pictogram chips per kind (chip = geography treatment,
 *             dashed = UNVERIFIED); four totals; a treemap of the sources
 *             clustered by geography (area ∝ fit) inside dashed boundaries;
 *             the ranking as a row of 100 circles
 *   share     who ranks where: each kind's share of a rolling 10-rank window,
 *             as hatched 100% bands
 *   units     fit by geography: one pictogram per source, stacked by fit
 *   index     the ranked list, the accessible source of truth
 *
 * Every mark carries `data-aif-r` (its rank); client ai-futures.ts lights one
 * source everywhere at once, pins, filters, and auto-advances. Each chart is
 * one keyboard stop (a slider over the ranking); kind rows and geography
 * boundaries are buttons that filter the index. Complete without JavaScript.
 */
import type { AtlasGraph, ResearchDocument } from '@atlas/core';
import {
  FIELD,
  FIELD_NARROW,
  GEO_NAME,
  HIST_NARROW,
  HIST_WIDE,
  KINDS,
  KIND_ROW,
  MAP,
  SHARE_NARROW,
  SHARE_WIDE,
  STATUSES,
  fieldLine,
  fieldMap,
  findMentions,
  futures,
  linkLabel,
  shareBands,
  statusCounts,
  unitHistogram,
} from '../../lib/ai-futures.ts';
import { ICONS, ICON_VIEWBOX, STATUS_MARKS } from '../../lib/futures-icons.ts';
import { jsonForHtml } from '../../lib/json.ts';

interface Props {
  graph: AtlasGraph;
  docs: readonly ResearchDocument[];
}

const { graph, docs } = Astro.props;
const { entries } = futures();
const n = entries.length;
const mentions = findMentions(entries, docs, graph);
const statuses = statusCounts(entries);
const statusOf = new Map(STATUSES.map((status) => [status.key, status]));
const byRank = new Map(entries.map((entry) => [entry.rank, entry]));
const statusAt = (rank: number): string => byRank.get(rank)?.verification.status ?? 'verified';
const pct = (a: number, b: number): string => `${String(Math.round((a / b) * 10000) / 100)}%`;
const fmt = (v: number): string => String(Math.round(v * 10) / 10);

// ── panel ────────────────────────────────────────────────────────────────────
const line = fieldLine(entries);
const narrowLine = fieldLine(entries, FIELD_NARROW);
const lines = [
  { variant: 'wide', box: FIELD, line },
  { variant: 'narrow', box: FIELD_NARROW, line: narrowLine },
] as const;
const map = fieldMap(entries);
const tileGap = 1.6;
const named = new Set(
  entries.filter((entry) => (mentions.get(entry.rank) ?? []).length > 0).map((entry) => entry.rank),
);
const stats = [
  { n: entries.filter((entry) => entry.geo === 'us').length, label: ['US', 'sources'], cls: '' },
  { n: entries.filter((entry) => entry.geo === 'cn').length, label: ['China', 'sources'], cls: 'is-cn' },
  { n: statuses.verified, label: ['links', 'verified'], cls: '' },
  { n: named.size, label: ['named in', 'the book'], cls: 'is-named' },
];
const lead = entries[0];
const firstSentence = (text: string): string => /^.+?[.;](?=\s+\p{Lu}|$)/u.exec(text)?.[0] ?? text;
const valueText = (rank: number): string => {
  const entry = byRank.get(rank);
  return entry === undefined
    ? String(rank)
    : `#${String(rank)} ${entry.name}, ${KIND_ROW[entry.kind]}, ${GEO_NAME[entry.geo]}, fit ${String(entry.fit)}`;
};
const slider = (label: string): Record<string, string> => ({
  role: 'slider',
  tabindex: '0',
  'aria-label': label,
  'aria-valuemin': '1',
  'aria-valuemax': String(n),
  'aria-valuenow': '1',
  'aria-valuetext': valueText(1),
  'data-aif-slider': '',
});

// ── charts ───────────────────────────────────────────────────────────────────
const shares = [
  { variant: 'wide', box: SHARE_WIDE, bands: shareBands(entries, SHARE_WIDE) },
  { variant: 'narrow', box: SHARE_NARROW, bands: shareBands(entries, SHARE_NARROW) },
] as const;
const rankTicks = [1, 25, 50, 75, 100].filter((rank) => rank <= n);
const hists = [
  { variant: 'wide', box: HIST_WIDE, hist: unitHistogram(entries, HIST_WIDE) },
  { variant: 'narrow', box: HIST_NARROW, hist: unitHistogram(entries, HIST_NARROW) },
] as const;

const island = {
  entries: entries.map((entry) => {
    const point = line.points[entry.rank - 1];
    const narrow = narrowLine.points[entry.rank - 1];
    return {
      rank: entry.rank,
      name: entry.name,
      kind: entry.kind,
      geo: entry.geo,
      fit: entry.fit,
      status: entry.verification.status,
      named: named.has(entry.rank),
      description: entry.description,
      reason: entry.reason,
      url: entry.links.url,
      x: point?.x ?? 0,
      y: point?.y ?? 0,
      nx: narrow?.x ?? 0,
      ny: narrow?.y ?? 0,
    };
  }),
  kinds: KIND_ROW,
  geos: GEO_NAME,
  statuses: Object.fromEntries(STATUSES.map((status) => [status.key, status.label])),
};
---

<section class="aif" data-aif-explorer aria-label="AI futures sources">
  <script type="application/json" data-aif-data set:html={jsonForHtml(island)}></script>
  <svg class="aif-defs" aria-hidden="true" focusable="false" width="0" height="0">
    <defs>
      {KINDS.map((kind) => (
        <symbol id={`aif-ic-${kind.key}`} viewBox={ICON_VIEWBOX}>
          <path d={ICONS[kind.key]} fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
        </symbol>
      ))}
      {STATUSES.map((status) => (
        <symbol id={`aif-st-${status.key}`} viewBox="-7 -7 14 14">
          <path d={STATUS_MARKS[status.key]} />
        </symbol>
      ))}
      <pattern id="aif-hatch-ink" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect class="aif-hatch aif-hatch--ink" width="7" height="7" />
        <rect class="aif-hatch aif-hatch--gap" width="2.4" height="7" />
      </pattern>
      <pattern id="aif-hatch-accent" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect class="aif-hatch aif-hatch--accent" width="7" height="7" />
        <rect class="aif-hatch aif-hatch--gap" width="2.4" height="7" />
      </pattern>
      <pattern id="aif-hatch-light" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect class="aif-hatch aif-hatch--gap" width="5" height="5" />
        <rect class="aif-hatch aif-hatch--ink" width="1.1" height="5" />
      </pattern>
      <pattern
        id="aif-hatch-light-accent"
        width="5"
        height="5"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
      >
        <rect class="aif-hatch aif-hatch--gap" width="5" height="5" />
        <rect class="aif-hatch aif-hatch--accent" width="1.1" height="5" />
      </pattern>
    </defs>
  </svg>

  <!-- ── 1 · the field panel ─────────────────────────────────────────────── -->
  <section class="aif-panel" data-aif-panel aria-labelledby="aif-h-field">
    <header class="aif-head">
      <h2 class="aif-h" id="aif-h-field">
        The field
      </h2>
      <p class="aif-cap">Fit is the supplier’s editorial score</p>
      <ul class="aif-key" aria-label="Chip key">
        <li>
          <span class="aif-chip aif-geo--us" aria-hidden="true"></span>US
        </li>
        <li>
          <span class="aif-chip aif-geo--cn" aria-hidden="true"></span>China
        </li>
        <li>
          <span class="aif-chip aif-geo--uk" aria-hidden="true"></span>UK
        </li>
        <li>
          <span class="aif-chip aif-geo--us is-unverified" aria-hidden="true"></span>UNVERIFIED
        </li>
      </ul>
    </header>

    <div class="aif-field">
      <div class="aif-fl" data-aif-inst="line" {...slider('Supplier fit down the ranking')}>
        {lines.map(({ variant, box, line: ln }) => {
          const at = ln.points[0] ?? { x: 0, y: box.top };
          return (
            <div class={`aif-fl__v is-${variant}`}>
              <svg
                class="aif-fl__svg"
                viewBox={`0 0 ${String(box.width)} ${String(box.height)}`}
                aria-hidden="true"
                focusable="false"
              >
                <path class="aif-fl__tone" d={ln.halftone} />
                <line class="aif-fl__axis" x1="0" y1={fmt(ln.base)} x2={String(box.width)} y2={fmt(ln.base)} />
                <rect
                  class="aif-fl__drop"
                  data-aif-drop={variant}
                  x="-0.5"
                  y="0"
                  width="1"
                  height={fmt(ln.base - at.y)}
                  style={`transform:translate(${fmt(at.x)}px,${fmt(at.y)}px)`}
                />
                <path class="aif-fl__line" d={ln.d} />
                <g
                  class="aif-fl__dot"
                  data-aif-dot={variant}
                  data-base={fmt(ln.base)}
                  style={`transform:translate(${fmt(at.x)}px,${fmt(at.y)}px)`}
                >
                  <circle class="aif-fl__pulse" r={variant === 'wide' ? '9' : '6.5'} />
                  <circle class="aif-fl__core" r={variant === 'wide' ? '8.5' : '6.5'} />
                </g>
                <g class="aif-fl__hits">
                  {ln.points.map((point) => (
                    <rect
                      data-aif-r={point.rank}
                      x={fmt(point.x - box.width / n / 2)}
                      y="0"
                      width={fmt(box.width / n)}
                      height={String(box.height)}
                    />
                  ))}
                </g>
              </svg>
              <span class="aif-tick is-fit is-top" style={`top:${pct(ln.peak, box.height)}`}>
                fit {ln.max}
              </span>
              <span class="aif-tick is-fit" style={`top:${pct(ln.base, box.height)}`}>
                {ln.min}
              </span>
              {rankTicks.map((rank) => (
                <span
                  class:list={['aif-tick is-rank', { 'is-first': rank === 1, 'is-last': rank === n }]}
                  style={`left:${pct((rank - 0.5) / n, 1)};top:${pct(ln.base + (variant === 'wide' ? 10 : 8), box.height)}`}
                >
                  {rank === 1 ? 'rank 1' : rank}
                </span>
              ))}
            </div>
          );
        })}
      </div>

      <aside class="aif-readout" data-aif-readout aria-live="polite" aria-label="Readout">
        <p class="aif-readout__kicker">
          <span data-aif-o="rank">#{lead?.rank}</span>
          <span data-aif-o="fit">fit {lead?.fit}</span>
          <span class={`aif-readout__st is-${statusAt(1)}`} data-aif-o="status">
            <svg class="aif-st__sym" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
              <use data-aif-o="stuse" href={`#aif-st-${statusAt(1)}`} />
            </svg>
            <span data-aif-o="sttext">{statusOf.get(lead?.verification.status ?? 'verified')?.label}</span>
          </span>
          <span class="aif-readout__book" data-aif-o="book" hidden={!named.has(1)}>
            in the book
          </span>
          <span class="aif-readout__pin" data-aif-o="pin" hidden>
            pinned · Esc
          </span>
        </p>
        <p class="aif-readout__title">
          <a data-aif-o="name" href={lead?.links.url} rel="external">
            {lead?.name}
          </a>
        </p>
        <p class="aif-readout__kind">
          <span class={`aif-chip aif-geo--${lead?.geo ?? 'us'} is-${statusAt(1)}`} data-aif-o="chip" aria-hidden="true">
            <svg viewBox={ICON_VIEWBOX} focusable="false">
              <use data-aif-o="kinduse" href={`#aif-ic-${lead?.kind ?? 'scenario'}`} />
            </svg>
          </span>
          <span data-aif-o="kind">{lead === undefined ? '' : KIND_ROW[lead.kind]}</span>
          <span class="aif-readout__geo" data-aif-o="geo">
            {lead === undefined ? '' : GEO_NAME[lead.geo]}
          </span>
        </p>
        <p class="aif-readout__desc" data-aif-o="desc">
          {lead?.description === null || lead === undefined
            ? `Supplier’s reason: ${lead?.reason ?? ''}`
            : firstSentence(lead.description)}
        </p>
      </aside>
    </div>

    <div class="aif-body">
      <div class="aif-kinds">
        <div class="aif-kinds__labels" role="group" aria-label="Filter the index by kind">
          {KINDS.map((kind) => (
            <button type="button" class="aif-klabel" data-aif-kind={kind.key} aria-pressed="false" title={kind.label}>
              {KIND_ROW[kind.key]}
            </button>
          ))}
        </div>
        <div class="aif-kinds__chips" data-aif-inst="chips" {...slider('Sources by kind')}>
          {KINDS.map((kind) => (
            <div class="aif-kinds__row" data-aif-row={kind.key}>
              {entries
                .filter((entry) => entry.kind === kind.key)
                .map((entry) => (
                  <span
                    class={`aif-chip aif-geo--${entry.geo} is-${entry.verification.status}`}
                    data-aif-r={entry.rank}
                  >
                    <svg viewBox={ICON_VIEWBOX} aria-hidden="true" focusable="false">
                      <use href={`#aif-ic-${entry.kind}`} />
                    </svg>
                  </span>
                ))}
            </div>
          ))}
        </div>
      </div>

      <dl class="aif-stats">
        {stats.map((stat) => (
          <div class={stat.cls}>
            <dt>
              {stat.label[0]}
              <br />
              {stat.label[1]}
            </dt>
            <dd>
              {stat.cls === 'is-named' && (
                <svg class="aif-stats__swatch" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <rect x="1" y="1" width="14" height="14" rx="3.5" />
                </svg>
              )}
              {stat.n}
            </dd>
          </div>
        ))}
      </dl>

      <div class="aif-map" style={`aspect-ratio:${String(MAP.width)} / ${fmt(map.height)}`}>
        <div class="aif-map__plot" data-aif-inst="map" {...slider('Sources by geography, area by fit')}>
          <svg
            class="aif-map__svg"
            viewBox={`0 0 ${String(MAP.width)} ${fmt(map.height)}`}
            aria-hidden="true"
            focusable="false"
          >
            {map.clusters.map((cluster) => (
              <rect
                class="aif-map__bound"
                data-aif-bound={cluster.geo}
                x={fmt(cluster.x + 1)}
                y={fmt(cluster.y)}
                width={fmt(cluster.w - 2)}
                height={fmt(cluster.h)}
                rx="9"
              />
            ))}
            {map.tiles.map((tile) => {
              const size = Math.min(15, tile.w - 7, tile.h - 7);
              return (
                <g
                  class:list={[
                    `aif-tile aif-geo--${tile.geo} is-${statusAt(tile.rank)}`,
                    { 'has-icon': tile.icon, 'is-named': named.has(tile.rank) },
                  ]}
                  data-aif-r={tile.rank}
                >
                  <rect
                    x={fmt(tile.x + tileGap)}
                    y={fmt(tile.y + tileGap)}
                    width={fmt(tile.w - 2 * tileGap)}
                    height={fmt(tile.h - 2 * tileGap)}
                    rx="4"
                  />
                  <use
                    class="aif-tile__ic"
                    href={`#aif-ic-${tile.kind}`}
                    x={fmt(tile.x + tile.w / 2 - size / 2)}
                    y={fmt(tile.y + tile.h / 2 - size / 2)}
                    width={fmt(size)}
                    height={fmt(size)}
                  />
                </g>
              );
            })}
          </svg>
        </div>
        {map.clusters.map((cluster) => (
          <button
            type="button"
            class:list={['aif-geolabel', { 'is-side': cluster.compact }]}
            data-aif-geo={cluster.geo}
            aria-pressed="false"
            style={
              cluster.compact
                ? `left:${pct(cluster.x + cluster.w + 8, MAP.width)};top:${pct(cluster.y + cluster.h / 2, map.height)}`
                : `left:${pct(cluster.x + 12, MAP.width)};top:${pct(cluster.y, map.height)}`
            }
          >
            {GEO_NAME[cluster.geo]}
          </button>
        ))}
        <p class="aif-map__note" aria-hidden="true">
          area = fit
        </p>
      </div>
    </div>

    <div class="aif-dots" data-aif-inst="dots" {...slider('The ranking, one circle per source')}>
      {entries.map((entry) => (
        <span class={`aif-dot aif-geo--${entry.geo} is-${entry.verification.status}`} data-aif-r={entry.rank} />
      ))}
    </div>
  </section>

  <!-- ── 2 · who ranks where ─────────────────────────────────────────────── -->
  <section class="aif-sec" aria-labelledby="aif-h-share">
    <header class="aif-head">
      <h2 class="aif-h" id="aif-h-share">
        Who ranks where
      </h2>
      <p class="aif-cap">Kind share, smoothed 10-rank window</p>
    </header>
    <div class="aif-area" data-aif-inst="area" {...slider('Kind share down the ranking')}>
      {shares.map(({ variant, box, bands }) => {
        const plotH = box.height - box.top - box.bottom;
        const plotW = box.width - box.left - box.right;
        const xOf = (rank: number): number => box.left + ((rank - 1) / (n - 1)) * plotW;
        return (
          <svg
            class={`aif-area__svg is-${variant}`}
            viewBox={`0 0 ${String(box.width)} ${String(box.height)}`}
            data-left={String(box.left)}
            data-plot={String(plotW)}
            aria-hidden="true"
            focusable="false"
            style={`--f:${String(box.font)}px`}
          >
            {bands.map((band) => (
              <path class={`aif-band is-f${String(band.index % 4)}`} data-kind={band.kind} d={band.d} />
            ))}
            <g class="aif-area__cursor" data-aif-cursor style={`transform:translateX(${fmt(xOf(1))}px)`}>
              <line x1="0" x2="0" y1={String(box.top)} y2={String(box.height - box.bottom)} />
              <line x1="0" x2="0" y1={String(box.top)} y2={String(box.height - box.bottom)} />
            </g>
            {bands.map((band) =>
              band.label === null ? null : (
                <g class="aif-area__lab" data-kind={band.kind}>
                  <rect
                    x={fmt(band.label.x)}
                    y={fmt(band.label.y)}
                    width={fmt(band.label.w)}
                    height={fmt(band.label.h)}
                  />
                  <text x={fmt(band.label.x + band.label.w / 2)} y={fmt(band.label.y + band.label.h / 2)}>
                    {KIND_ROW[band.kind]}
                  </text>
                </g>
              ),
            )}
            {[0, 50, 100].map((p) => (
              <text class="aif-area__pct" x={String(box.left - 8)} y={fmt(box.top + (1 - p / 100) * plotH)}>
                {p}%
              </text>
            ))}
            {rankTicks.map((rank) => (
              <text
                class:list={['aif-area__rank', { 'is-first': rank === 1, 'is-last': rank === n }]}
                x={fmt(xOf(rank))}
                y={String(box.height - 8)}
              >
                {rank === 1 ? 'rank 1' : rank}
              </text>
            ))}
          </svg>
        );
      })}
    </div>
    <p class="aif-mini" data-aif-mini aria-hidden="true"></p>
  </section>

  <!-- ── 3 · fit by geography ────────────────────────────────────────────── -->
  <section class="aif-sec" aria-labelledby="aif-h-units">
    <header class="aif-head">
      <h2 class="aif-h" id="aif-h-units">
        Fit by geography
      </h2>
      <p class="aif-cap">One pictogram per source, stacked by fit</p>
      <ul class="aif-key is-text" aria-label="Colour key">
        <li class="aif-geo--us">US</li>
        <li class="aif-geo--cn">China</li>
        <li class="aif-geo--uk">UK</li>
      </ul>
    </header>
    <div class="aif-units" data-aif-inst="units" {...slider('Sources by fit score')}>
      {hists.map(({ variant, box, hist }) => (
        <svg
          class={`aif-units__svg is-${variant}`}
          viewBox={`0 0 ${String(box.width)} ${fmt(hist.height)}`}
          aria-hidden="true"
          focusable="false"
        >
          <line
            class="aif-units__base"
            x1="0"
            x2={String(box.width)}
            y1={fmt(hist.base + 1.5)}
            y2={fmt(hist.base + 1.5)}
          />
          {hist.bands.map((band) => (
            <text class="aif-units__band" x={fmt(band.x)} y={fmt(band.top - (variant === 'wide' ? 9 : 6))}>
              {variant === 'wide'
                ? band.first === band.last
                  ? `rank ${String(band.first)}`
                  : `ranks ${String(band.first)}–${String(band.last)}`
                : `#${String(band.first)}${band.first === band.last ? '' : `–${String(band.last)}`}`}
            </text>
          ))}
          {hist.columns
            .filter((column) => column.fit % 5 === 0 || column.fit === line.max)
            .map((column) => (
              <text class="aif-units__fit" x={fmt(column.x)} y={fmt(hist.base + (variant === 'wide' ? 20 : 16))}>
                {column.fit}
              </text>
            ))}
          {hist.units.map((unit) => (
            <g
              class={`aif-unit aif-geo--${unit.geo} is-${statusAt(unit.rank)}`}
              data-aif-r={unit.rank}
              transform={`translate(${fmt(unit.x)} ${fmt(unit.y)})`}
            >
              <rect
                class="aif-unit__hit"
                x={fmt(-hist.column / 2)}
                y={fmt(-box.pitch / 2)}
                width={fmt(hist.column)}
                height={fmt(box.pitch)}
                rx="3"
              />
              {variant === 'wide' ? (
                <use
                  class="aif-unit__ic"
                  href={`#aif-ic-${unit.kind}`}
                  x={fmt(-box.unit / 2)}
                  y={fmt(-box.unit / 2)}
                  width={fmt(box.unit)}
                  height={fmt(box.unit)}
                />
              ) : (
                <rect
                  class="aif-unit__sq"
                  x={fmt(-box.unit / 2)}
                  y={fmt(-box.unit / 2)}
                  width={fmt(box.unit)}
                  height={fmt(box.unit)}
                  rx="1.6"
                />
              )}
            </g>
          ))}
        </svg>
      ))}
    </div>
    <p class="aif-mini" data-aif-mini aria-hidden="true"></p>
  </section>

  <!-- ── 4 · the index ───────────────────────────────────────────────────── -->
  <section class="aif-sec" aria-labelledby="aif-h-index">
    <header class="aif-head">
      <h2 class="aif-h" id="aif-h-index">
        Index
      </h2>
      <p class="aif-cap">In the supplier’s order</p>
    </header>
    <div class="aif-bar" role="group" aria-label="Filters">
      {STATUSES.filter((status) => statuses[status.key] > 0).map((status) => (
        <button
          type="button"
          class={`aif-fchip aif-st is-${status.key}`}
          data-aif-status={status.key}
          aria-pressed="false"
          title={status.title}
        >
          <svg class="aif-st__sym" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
            <use href={`#aif-st-${status.key}`} />
          </svg>
          {status.label}
        </button>
      ))}
      <span class="aif-bar__tokens" data-aif-tokens></span>
      <label class="aif-search">
        <span class="sh-visually-hidden">Filter by name, organisation, or description</span>
        <input type="search" placeholder="Filter…" data-aif-search autocomplete="off" spellcheck="false" />
      </label>
      <button type="button" class="aif-clear" data-aif-clear hidden>
        clear
      </button>
      <span class="aif-shown" data-aif-shown aria-live="polite">
        {n} of {n}
      </span>
    </div>

    <ol class="aif-index" data-aif-index aria-label="The 100 sources in the supplier’s order">
      {entries.map((entry) => {
        const status = entry.verification.status;
        return (
          <li
            id={`aif-${String(entry.rank)}`}
            class={`aif-line aif-geo--${entry.geo} is-${status}`}
            data-aif-r={entry.rank}
            data-aif-line={entry.rank}
            data-kind={entry.kind}
            data-geo={entry.geo}
            data-status={status}
            data-text={`${entry.name} ${entry.short} ${entry.org} ${entry.description ?? ''} ${entry.reason} ${entry.links.url}`.toLowerCase()}
          >
            <span class="aif-line__rank" title={`Supplier’s rank ${String(entry.rank)} · fit ${String(entry.fit)}`}>
              {entry.rank}
              <small>{entry.fit}</small>
            </span>
            <span class="aif-line__name">
              <a href={entry.links.url} rel="external">
                {entry.name}
              </a>
              {entry.org !== entry.name && <span class="aif-line__org">{entry.org}</span>}
            </span>
            <span class="aif-line__kind" title={`${KIND_ROW[entry.kind]} · ${GEO_NAME[entry.geo]}`}>
              <span class={`aif-chip aif-geo--${entry.geo} is-${status}`} aria-hidden="true">
                <svg viewBox={ICON_VIEWBOX} focusable="false">
                  <use href={`#aif-ic-${entry.kind}`} />
                </svg>
              </span>
              <span class="sh-visually-hidden">{KIND_ROW[entry.kind]},</span>
              <span class="aif-line__geo">{entry.geo === 'cn' ? 'CN' : entry.geo.toUpperCase()}</span>
            </span>
            <span class="aif-line__desc">
              <span class="aif-line__text">
                {entry.description === null ? (
                  <em class="aif-line__reason">Supplier’s reason: {entry.reason}</em>
                ) : (
                  entry.description
                )}
              </span>
              {status !== 'verified' && entry.verification.note !== '' && (
                <details class="aif-check">
                  <summary>{entry.verification.note}</summary>
                  {status === 'redirected' && <span class="aif-check__listed">Listed: {entry.links.listed}</span>}
                </details>
              )}
            </span>
            <span
              class={`aif-line__st is-${status}`}
              title={`${statusOf.get(status)?.label ?? status}${entry.verification.note === '' ? '' : ` — ${entry.verification.note}`} · ${linkLabel(entry.links.url)}`}
            >
              <svg class="aif-st__sym" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                <use href={`#aif-st-${status}`} />
              </svg>
              <span class="sh-visually-hidden">{statusOf.get(status)?.label}</span>
            </span>
          </li>
        );
      })}
    </ol>
  </section>
</section>
