---
/**
 * Stack Explorer — the graph page's instrument: the whole book as one
 * connected dependency map (UI_UX §36, §83–84; the AI 2027 lesson that every
 * mark on the page is part of one responsive system).
 *
 *   lanes      11 parts, grouped by volume; 6 chapter nodes per lane, each
 *              labelled in two wrapped lines at a readable size
 *   edges      every declared prerequisite (plan + manuscripts), faint at rest
 *   readout    what the focused chapter is, what it builds on, what it unlocks
 *   routes     reading routes and integrated studies drawn as paths through the book
 *
 * Every node opens that chapter's Map (its local neighbourhood). Server-rendered
 * SVG + HTML: every node is a real link and every route has a text form, so
 * the map works without JavaScript and is never the only representation
 * (UI_UX §60). The client (stack-explorer.ts) adds the connected behaviour:
 * transitive upstream/downstream tracing, route paths with order badges, and
 * cross-lighting between map, readout, and the part listing below.
 */
import type { StackModel } from '../../lib/stack.ts';
import { jsonForHtml } from '../../lib/json.ts';
import { stackFacts, wrapLabel } from '../../lib/stack-map.ts';
import { mapUrl } from '../../lib/urls.ts';

interface Props {
  model: StackModel;
}

const { model: source } = Astro.props;

// On the graph page every chapter opens its Map; the readout's links follow.
const model: StackModel = {
  ...source,
  chapters: Object.fromEntries(
    Object.entries(source.chapters).map(([key, chapter]) => [key, { ...chapter, url: mapUrl(chapter.url) }]),
  ),
  lineage: [],
};

// ── geometry (SVG user units = CSS px at the 1440 px layout) ────────────────
const W = 760;
const LABEL_W = 150;
const COL0 = 192;
const COL_STEP = 102;
const LANE_H = 58;
const NODE_Y = 17;
const VOL_H = 24;
const TOP = 2;

interface LaneGeo {
  readonly part: StackModel['parts'][number];
  readonly y: number;
  readonly lines: readonly string[];
}
const lanes: LaneGeo[] = [];
const volumeRows: { volume: StackModel['volumes'][number]; y: number }[] = [];
let y = TOP;
for (const volume of model.volumes) {
  volumeRows.push({ volume, y });
  y += VOL_H;
  for (const partNumber of volume.parts) {
    const part = model.parts.find((candidate) => candidate.n === partNumber);
    if (part === undefined) continue;
    lanes.push({ part, y: y + NODE_Y, lines: wrapLabel(part.title, 21, 2) });
    y += LANE_H;
  }
  y += 4;
}
const H = y;

const pos = new Map<number, { x: number; y: number }>();
for (const lane of lanes) {
  lane.part.chapters.forEach((n, index) => pos.set(n, { x: COL0 + index * COL_STEP, y: lane.y }));
}

const R = 11;
function edgePath(from: number, to: number): string | null {
  const a = pos.get(from);
  const b = pos.get(to);
  if (a === undefined || b === undefined) return null;
  if (Math.abs(a.y - b.y) < 1) {
    const lift = 14 + Math.abs(b.x - a.x) * 0.1;
    return `M${a.x} ${a.y - R} C${a.x} ${a.y - lift}, ${b.x} ${b.y - lift}, ${b.x} ${b.y - R}`;
  }
  const dy = b.y - a.y;
  return `M${a.x} ${a.y + Math.sign(dy) * R} C${a.x} ${a.y + dy * 0.5}, ${b.x} ${b.y - dy * 0.5}, ${b.x} ${b.y - Math.sign(dy) * R}`;
}

const chapters = Object.values(model.chapters).sort((a, b) => a.n - b.n);
const facts = stackFacts(chapters);
const restSummary =
  facts.keystone === null
    ? ''
    : `${facts.keystone.number} ${facts.keystone.short} is the keystone: ${facts.keystone.downstream >= facts.total - 1 ? 'every other chapter rests on it' : `${String(facts.keystone.downstream)} later chapters rest on it`}.`;
// Rest-state links: the chapters the most others rest on (transitively).
const keystones = [...chapters].sort((a, b) => b.downstream - a.downstream || a.n - b.n).slice(0, 5);
---

<section class="sx gx-inst" aria-labelledby="sx-title" data-stack-explorer>
  <p class="gx-head">
    <span class="gx-head__title" id="sx-title">
      Dependency map
    </span>
    <span class="gx-head__note">one node per chapter · line = prerequisite</span>
    <span class="gx-head__keys" aria-hidden="true">
      <span class="gx-key gx-key--up">builds on</span>
      <span class="gx-key gx-key--down">unlocks</span>
      <span class="gx-key sx-key--route">route</span>
    </span>
  </p>

  <div class="sx-body gx-body">
    <div class="sx-map gx-main" role="group" aria-label="Chapters by part, with prerequisite links">
      <svg
        class="sx-svg"
        viewBox={`0 0 ${String(W)} ${String(H)}`}
        role="img"
        aria-labelledby="sx-svg-title sx-svg-desc"
        data-sx-svg
      >
        <title id="sx-svg-title">Dependency map of the {chapters.length} chapters</title>
        <desc id="sx-svg-desc">
          {lanes.length} lanes, one per part, in {model.volumes.length} volumes. {facts.written} chapters have
          manuscripts.
          {model.edges.length} prerequisite links connect earlier chapters to later ones. Each node opens that chapter's
          map.
        </desc>

        {volumeRows.map(({ volume, y: vy }) => (
          <g class="sx-volume">
            <line class="sx-volume__rule" x1="0" x2={W} y1={vy + 0.5} y2={vy + 0.5} />
            <text class="sx-volume__label" x="0" y={vy + 15}>
              <a href={volume.url}>
                VOLUME {volume.numeral} · {volume.title.toUpperCase()}
              </a>
            </text>
          </g>
        ))}

        {lanes.map(({ part, y: ly, lines }) => (
          <g class="sx-lane" data-sx-part={part.n} data-domain={part.domain}>
            <line class="sx-lane__rule" x1={LABEL_W + 16} x2={W} y1={ly} y2={ly} />
            <a href={mapUrl(part.url)} class="sx-lane__link">
              <text class="sx-lane__num" x="0" y={lines.length > 1 ? ly - 2 : ly + 4}>
                {part.numeral}
              </text>
              <text class="sx-lane__title" x="36" y={lines.length > 1 ? ly - 2 : ly + 4}>
                {lines.map((line, index) => (
                  <tspan x="36" dy={index === 0 ? 0 : 13.5}>
                    {line}
                  </tspan>
                ))}
              </text>
            </a>
          </g>
        ))}

        <g class="sx-edges" aria-hidden="true">
          {model.edges.map(([from, to]) => {
            const d = edgePath(from, to);
            return d === null ? null : <path class="sx-edge" d={d} data-from={from} data-to={to} />;
          })}
        </g>

        <g class="sx-route" aria-hidden="true" data-sx-route-layer>
          <path class="sx-route__path" d="" data-sx-route-path />
          <g data-sx-route-badges></g>
        </g>

        <g class="sx-nodes">
          {chapters.map((chapter) => {
            const p = pos.get(chapter.n);
            if (p === undefined) return null;
            const label = wrapLabel(chapter.short, 18, 2);
            return (
              <a
                class:list={['sx-node', { 'sx-node--written': chapter.written }]}
                href={chapter.url}
                data-sx-node={chapter.n}
                data-domain={chapter.domain}
                aria-label={`Map of ${chapter.number} ${chapter.title}. ${chapter.written ? `${String(chapter.sectionsWritten)} of ${String(chapter.sectionsTotal)} sections written` : 'planned'}. Builds on ${String(chapter.prereqs.length)}, unlocks ${String(chapter.unlocks.length)}.`}
                tabindex={chapter.n === 1 ? 0 : -1}
              >
                <circle class="sx-node__hit" cx={p.x} cy={p.y} r="17" />
                <circle class="sx-node__dot" cx={p.x} cy={p.y} r={R} />
                <text class="sx-node__num" x={p.x} y={p.y + 3.4}>
                  {chapter.number}
                </text>
                <text class="sx-node__label" x={p.x} y={p.y + 23}>
                  {label.map((line, index) => (
                    <tspan x={p.x} dy={index === 0 ? 0 : 11.5}>
                      {line}
                    </tspan>
                  ))}
                </text>
              </a>
            );
          })}
        </g>
      </svg>
    </div>

    <aside class="sx-panel" aria-label="Explorer readout">
      <div class="sx-readout gx-readout" data-sx-readout aria-live="polite">
        <p class="gx-ro__kicker" data-sx-kicker>
          {chapters.length} chapters · {model.edges.length} links
        </p>
        <p class="gx-ro__title" data-sx-title>
          Point at a chapter or a route
        </p>
        <p class="gx-ro__text sx-readout__summary" data-sx-summary>
          {restSummary}
        </p>
        <dl class="gx-ro__rows sx-readout__rows" data-sx-rows>
          <div>
            <dt>chapters written</dt>
            <dd>
              {facts.written} / {facts.total}
            </dd>
          </div>
          <div>
            <dt>prerequisite links</dt>
            <dd>{model.edges.length}</dd>
          </div>
          <div>
            <dt>deepest chapter</dt>
            <dd>
              {facts.deepest === null ? '—' : `${facts.deepest.number} · rests on ${String(facts.deepest.upstream)}`}
            </dd>
          </div>
          <div>
            <dt>routes and studies</dt>
            <dd>{model.routes.length}</dd>
          </div>
        </dl>
        <p class="sx-readout__links" data-sx-links>
          <span class="sx-links__group">
            <span class="sx-links__label">most rested on</span>
            {keystones.map((chapter) => (
              <a
                href={chapter.url}
                title={`${chapter.title} · ${String(chapter.downstream)} rest on it`}
                data-sx-jump={chapter.n}
                class={chapter.written ? 'is-written' : 'is-planned'}
              >
                {chapter.number}
              </a>
            ))}
          </span>
        </p>
      </div>

      {model.routes.length > 0 && (
        <div class="sx-routes">
          <p class="sx-routes__head">Routes and studies</p>
          <ol class="sx-routes__list" role="list">
            {model.routes.map((route, index) => (
              <li>
                <button type="button" class="sx-route-btn" data-sx-route={index} aria-pressed="false">
                  <span class="sx-route-btn__label">{route.label}</span>
                  <span class="sx-route-btn__count">{route.chapters.length} ch</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      )}
    </aside>
  </div>

  <script is:inline type="application/json" data-sx-model set:html={jsonForHtml(model)}></script>
</section>
