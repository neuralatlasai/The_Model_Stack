---
/**
 * Site footer: the mark and title, reference pages in three groups, and one
 * line of edition and return navigation. Shares the top bar's edges. No marketing
 * copy.
 */
import { getGraph, getManifest } from '../../lib/atlas.ts';
import { BOOK_TITLE } from '../../lib/jsonld.ts';
import BrandMark from './BrandMark.astro';

const [manifest, graph] = await Promise.all([getManifest(), getGraph()]);
const notation = graph.nodes['ms.frontmatter.notation'];
const routes = graph.nodes['ms.frontmatter.reading-routes'];
const [bookName = BOOK_TITLE, bookSub = ''] = BOOK_TITLE.split(' — ');
---

<footer class="sh-footer">
  <div class="sh-footer-inner">
    <div class="sh-footer-id">
      <a class="sh-footer-brand" href="/" aria-label={`${bookName} — home`}>
        <BrandMark size={30} />
        <span>{bookName}</span>
      </a>
      {bookSub !== '' && <p class="sh-footer-sub">{bookSub}</p>}
    </div>
    <nav class="sh-footer-nav" aria-label="Reference pages">
      <div class="sh-footer-col">
        <p class="sh-footer-h">The book</p>
        <ul>
          {routes !== undefined && (
            <li>
              <a href={routes.url}>Reading routes</a>
            </li>
          )}
          {notation !== undefined && (
            <li>
              <a href={notation.url}>Notation</a>
            </li>
          )}
          <li>
            <a href="/terms/">Terms</a>
          </li>
          <li>
            <a href="/evidence/">Evidence labels</a>
          </li>
        </ul>
      </div>
      <div class="sh-footer-col">
        <p class="sh-footer-h">The atlas</p>
        <ul>
          <li>
            <a href="/library/">Library</a>
          </li>
          <li>
            <a href="/timeline/">Timeline</a>
          </li>
          <li>
            <a href="/evaluation-ecosystem/">Evaluation ecosystem</a>
          </li>
          <li>
            <a href="/ai-futures/">AI futures</a>
          </li>
        </ul>
      </div>
      <div class="sh-footer-col">
        <p class="sh-footer-h">Research objects</p>
        <ul>
          <li>
            <a href="/figures/">Visual explanations</a>
          </li>
          <li>
            <a href="/equations/">Equations and notation</a>
          </li>
          <li>
            <a href="/papers/">Source papers</a>
          </li>
          <li>
            <a href="/compare/">Compare methods</a>
          </li>
        </ul>
      </div>
    </nav>
    <p class="sh-footer-meta">
      <span>Edition {manifest.edition}</span>
      <span aria-hidden="true">·</span>
      <a href="#main">Back to top ↑</a>
    </p>
  </div>
</footer>
