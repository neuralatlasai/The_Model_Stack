---
/**
 * Theme toggle. The client (data-action="toggle-theme") cycles
 * light → dark → system, persists STORAGE_KEYS.theme and sets
 * <html data-theme>; the inline bootstrap applies the stored value before
 * paint. Both glyphs are drawn; CSS shows the one for the resolved theme.
 */
---

<button type="button" class="sh-icon-button sh-theme" data-action="toggle-theme" aria-label="Colour theme" title="Colour theme">
  <svg class="sh-icon sh-theme-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
    <path
      d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"></path>
  </svg>
  <svg class="sh-icon sh-theme-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
    <path d="M13.2 10.1A5.6 5.6 0 0 1 5.9 2.8a5.6 5.6 0 1 0 7.3 7.3Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path>
  </svg>
</button>
