---
/**
 * The home page's instrument panel in the AI 2040 register, made live:
 *
 * - every row is a link to where those objects live (library, papers,
 *   equations, figures, terms);
 * - the glyph is the book itself: one row per part (I–XI), one dot per
 *   chapter, filled = manuscript written. Every dot is a link to its chapter;
 *   hovering or focusing one writes a readout line (number, title, state,
 *   sections written) — the panel answers "what is this?" in place;
 * - the legend lines light their dot set, and the universe map beside the
 *   panel lights the matching dot or part row (client `atlas-instrument.ts`).
 *
 * Without JavaScript the dots remain plain links with accessible names; the
 * readout keeps its default line. Keyboard: the dot grid is one tab stop and
 * arrow keys move within it (roving tabindex, set up by the client).
 */
import { grouped } from '../../lib/format.ts';
import type { InstrumentPart, InstrumentRow } from '../../lib/instrument.ts';

interface Props {
  readonly header: string;
  readonly rows: readonly InstrumentRow[];
  readonly parts: readonly InstrumentPart[];
  readonly legend: { readonly filled: string; readonly hollow: string };
}

const { header, rows, parts, legend } = Astro.props;
const dots = parts.flatMap((part) => part.dots);
const filledCount = dots.filter((dot) => dot.filled).length;
const defaultReadout = `${String(filledCount)} of ${String(dots.length)} chapters written · hover a dot`;
---

<figure class="sh-instrument" aria-labelledby="atlas-instrument-title" data-atlas-instrument>
  <figcaption class="sh-instrument-head" id="atlas-instrument-title">{header}</figcaption>
  <dl class="sh-instrument-rows">
    {
      rows.map((row) => (
        <div class:list={['sh-instrument-row', { 'sh-instrument-row--link': row.href !== undefined }]}>
          <dt>{row.href !== undefined ? <a href={row.href}>{row.key}</a> : row.key}</dt>
          <dd>
            {grouped(row.value)}
            {row.note !== undefined && <span class="sh-instrument-note">{row.note}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
  <div class="sh-instrument-glyph">
    <p class="sh-visually-hidden">
      {filledCount} of {dots.length} chapters have manuscripts; the others are planned. Each dot links to its chapter.
    </p>
    <ol class="sh-dotgrid" role="list" aria-label="Chapters by part">
      {
        parts.map((part) => (
          <li class="sh-dotrow" data-part-id={part.id} data-domain={part.domain}>
            <span class="sh-dotrow-num" title={`Part ${part.numeral} — ${part.title}`}>{part.numeral}</span>
            <ol class="sh-dotrow-dots" role="list">
              {part.dots.map((dot, index) => (
                <li>
                  <a
                    class:list={['sh-dot', { 'sh-dot--filled': dot.filled }]}
                    href={dot.href}
                    data-dot={dot.id}
                    data-readout={dot.readout}
                    tabindex={index === 0 && part === parts[0] ? 0 : -1}
                    aria-label={dot.readout}
                  />
                </li>
              ))}
            </ol>
          </li>
        ))
      }
    </ol>
    <p class="sh-readout" data-instrument-readout data-default={defaultReadout} aria-live="polite">{defaultReadout}</p>
    <ul class="sh-instrument-legend">
      <li data-legend="filled">
        <span class="sh-dot sh-dot--filled sh-dot--legend" aria-hidden="true"></span>{legend.filled}<span class="sh-leader" aria-hidden="true"></span><span class="sh-legend-value">{filledCount}</span>
      </li>
      <li data-legend="hollow">
        <span class="sh-dot sh-dot--legend" aria-hidden="true"></span>{legend.hollow}<span class="sh-leader" aria-hidden="true"></span><span class="sh-legend-value">{dots.length - filledCount}</span>
      </li>
    </ul>
  </div>
</figure>
