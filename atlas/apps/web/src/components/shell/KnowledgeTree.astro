---
/**
 * Left rail: the recursive knowledge tree (UI_UX §5) — Volume → Part →
 * Chapter → Section, then front matter and appendices.
 *
 * Server-rendered for the current page: the active branch is expanded, its
 * ancestors stay visible, unrelated branches are collapsed, planned nodes are
 * muted but navigable. The element persists across ClientRouter navigations
 * (`transition:persist`, named per current chapter — see persistName), so the
 * client re-syncs `aria-current`,
 * `aria-expanded`, `hidden`, and the roving tabindex on `astro:page-load`
 * (see TreeBranch.astro for the DOM contract).
 *
 * At ≥1440 px it is an in-flow column; below that it is a native popover
 * (off-canvas navigator) opened by the top-bar or dock toggle.
 */
import type { GraphNode, NodeId } from '@atlas/core';
import { getGraph } from '../../lib/atlas.ts';
import { enclosing, treeContains, treeState } from '../../lib/nodes.ts';
import TreeBranch from './TreeBranch.astro';
import { href } from '../research/lib/site.ts';

interface Props {
  readonly currentId: NodeId | null;
}

const { currentId } = Astro.props;
const graph = await getGraph();
const state = treeState(graph, currentId);
const firstRoot = graph.tree[0]?.id ?? null;
const focusId = state.currentId !== null && treeContains(graph.tree, state.currentId) ? state.currentId : firstRoot;
const entityOf = (id: string): string => graph.nodes[id]?.entityType ?? 'node';
/*
 * Only the current chapter's children are server-rendered. Other written
 * chapters load their small section index on expansion. Changing chapters
 * must replace this persisted tree so the destination's active subtree is
 * always present, including without JavaScript.
 */
const currentChapter = state.currentId === null ? null : enclosing(graph, state.currentId, 'chapter');
const persistName = currentChapter === null ? 'knowledge-tree' : `knowledge-tree-${currentChapter.id}`;
const chapterLinks = graph.order
  .map((id) => graph.nodes[id])
  .filter((node): node is GraphNode => node?.entityType === 'chapter');
const currentSections = (currentChapter?.children ?? [])
  .map((id) => graph.nodes[id])
  .filter((node): node is GraphNode => node !== undefined);
---

<nav
  id="knowledge-tree"
  class="sh-tree"
  aria-label="Knowledge tree"
  popover
  data-tree-panel
  transition:persist={persistName}
>
  <div class="sh-tree-head">
    <span class="sh-tree-title" id="knowledge-tree-title">
      Contents
    </span>
    <button type="button" class="sh-panel-close" popovertarget="knowledge-tree" popovertargetaction="hide">
      Close
    </button>
  </div>
  <noscript>
    <style is:inline>
      .sh-tree-list {
        display: none !important;
      }
    </style>
    <div class="sh-tree-fallback" data-tree-fallback>
      <p class="sh-tree-note">Open a chapter to browse its sections. These links work without JavaScript.</p>
      {currentSections.length > 0 && (
        <section aria-label="Current chapter sections">
          <h2>Chapter {currentChapter?.number} sections</h2>
          <ul role="list">
            {currentSections.map((node) => (
              <li>
                <a href={href(node.url)} aria-current={node.id === currentId ? 'page' : undefined}>
                  {node.number !== null ? `${node.number} ` : ''}
                  {node.shortTitle}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <section aria-label="All chapters">
        <h2>All chapters</h2>
        <ol role="list">
          {chapterLinks.map((node) => (
            <li>
              <a
                href={href(node.url)}
                data-fallback-chapter={node.id}
                aria-current={node.id === currentId ? 'page' : undefined}
              >
                {node.number} {node.shortTitle}
                {!node.hasManuscript && ' (planned)'}
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </noscript>
  <ul
    role="tree"
    class="sh-tree-list"
    aria-labelledby="knowledge-tree-title"
    style={`--tree-num:${String(Math.max(0, ...graph.tree.map((node) => node.number?.length ?? 0)))}ch`}
  >
    <TreeBranch nodes={graph.tree} level={1} state={state} focusId={focusId} entityOf={entityOf} />
  </ul>
</nav>
