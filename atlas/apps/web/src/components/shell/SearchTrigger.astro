---
/**
 * Search trigger (UI_UX §32–33). The palette itself is client code
 * (apps/web/src/client); this button is its server-rendered entry point and
 * advertises the ⌘K / Ctrl-K shortcut the client binds globally.
 */
---

<button
  type="button"
  class="sh-search"
  data-action="open-search"
  aria-haspopup="dialog"
  aria-keyshortcuts="Meta+K Control+K"
>
  <svg class="sh-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
    <circle cx="6.75" cy="6.75" r="4.75" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
    <path d="M10.3 10.3 14 14" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"></path>
  </svg>
  <span class="sh-search-label">Search</span>
  <kbd class="sh-search-kbd" aria-hidden="true">⌘K</kbd>
</button>
