---
/**
 * Conceptual hierarchy (UI_UX §34): quiet, one line, every ancestor a link,
 * the current node last and unlinked. Never a second navigation bar.
 */
interface Crumb {
  readonly title: string;
  readonly number: string | null;
  readonly url: string;
}

interface Props {
  readonly crumbs: readonly Crumb[];
  readonly current: string;
}

const { crumbs, current } = Astro.props;
/** "Volume I" and "Part II" already carry their numeral; only other crumbs get the mono number. */
const showNumber = (crumb: Crumb): crumb is Crumb & { readonly number: string } =>
  crumb.number !== null && !crumb.title.split(/\s+/u).includes(crumb.number);
---

{
  crumbs.length > 0 && (
    <nav class="sh-crumbs" aria-label="Breadcrumb">
      <ol class="sh-crumbs-list">
        {crumbs.map((crumb) => (
          <li class="sh-crumb">
            <a href={crumb.url}>
              {showNumber(crumb) && <span class="sh-crumb-num">{crumb.number}</span>}
              {crumb.title}
            </a>
          </li>
        ))}
        <li class="sh-crumb sh-crumb--current" aria-current="page">
          {current}
        </li>
      </ol>
    </nav>
  )
}
