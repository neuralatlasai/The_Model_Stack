---
/**
 * Library: the manuscript as an instrument — every volume, part, chapter, and
 * section with its editorial state, as one connected prerequisite weave,
 * manuscript map, fixed readout, and catalogue (components/shell/
 * LibraryExplorer.astro, client library-explorer.ts). Front matter and
 * appendices follow.
 */
import { inlineToText, type NodeId } from '@atlas/core';
import LibraryExplorer from '../components/shell/LibraryExplorer.astro';
import PageHeader from '../components/shell/PageHeader.astro';
import ReaderLayout from '../layouts/ReaderLayout.astro';
import { getDocument, getGraph, getRegistry, hasDocument } from '../lib/atlas.ts';
import { grouped } from '../lib/format.ts';
import { buildLibraryModel } from '../lib/library-model.ts';
import { getStackModel } from '../lib/stack.ts';
import '../styles/library.css';

const [graph, registry, stack] = await Promise.all([getGraph(), getRegistry(), getStackModel()]);
// Full chapter theses from the compiled documents (the graph keeps a capped excerpt).
const pairs = await Promise.all(
  Object.values(stack.chapters).map(async (chapter): Promise<readonly [string, string] | null> => {
    const id = chapter.id as NodeId;
    if (!(await hasDocument(id))) return null;
    const thesis = (await getDocument(id)).header.thesis;
    return thesis === null ? null : [id, inlineToText(thesis).trim()];
  }),
);
const theses = new Map(pairs.filter((pair) => pair !== null));
const model = buildLibraryModel(graph, registry, stack, theses);
const { totals } = model;
---

<ReaderLayout
  title="Library"
  description="Every volume, part, chapter, and section of The Model Stack with its editorial state and manuscript coverage, as one connected map."
  canonicalPath="/library/"
  currentId={null}
  navKey="library"
>
  <PageHeader
    identity="Research Atlas / Library"
    title="Library"
    lede="Where the writing stands, section by section — and what each chapter builds on and unlocks."
    meta={`${String(totals.chaptersWritten)} of ${String(totals.chapters)} chapters written · ${String(totals.sectionsWritten)} of ${String(totals.sections)} sections drafted · ${grouped(totals.words)} words`}
  />
  <LibraryExplorer model={model} edges={stack.edges} />
</ReaderLayout>
