---
/**
 * Visual grammar reference (docs/VISUAL_GRAMMAR.md): every node and edge
 * primitive, one realistic figure of every kind, and the live rail instruments
 * with their scroll-driven states. The kind examples are the grammar's own
 * YAML, parsed with core `FigureSpecSchema`, laid out with `layoutFigure`, and
 * drawn by `<Figure>` from @atlas/visual/svg, so this page is both the
 * renderer's review canvas and the authors' reference.
 *
 * The state stepper under each live instrument is a demonstration driver for
 * the DOM contract (`data-states`, `data-vg-key`, `data-vg-value`,
 * `data-vg-frac` / `--vg-frac`, `data-vg-cursor`); the reader's rail drives the
 * same attributes from scroll position.
 */
import { parse as parseYaml } from 'yaml';
import { EDGE_KINDS, FigureSpecSchema, NODE_KINDS, type CompiledFigure, type EdgeKind, type NodeKind } from '@atlas/core';
import { describeFigure, layoutFigure } from '@atlas/visual';
import { EdgeSpecimen, Figure, NodeSpecimen } from '@atlas/visual/svg';
import { figureHostProps, type FigureHostProps } from '../components/research/lib/figure-host.ts';
import PageHeader from '../components/shell/PageHeader.astro';
import ReaderLayout from '../layouts/ReaderLayout.astro';
import grammarSource from '../../../../../docs/VISUAL_GRAMMAR.md?raw';

const grammar = grammarSource.replace(/\r\n?/gu, '\n');

/** The grammar's per-kind `spec:` examples (§5.1–5.12), with the YAML quoting the flow mappings need. */
function kindExamples(): Map<string, unknown> {
  const out = new Map<string, unknown>();
  const headings = [...grammar.matchAll(/^### (5\.\d+) `([a-z-]+)`\s*$/gmu)];
  headings.forEach((heading, index) => {
    const start = heading.index;
    const next = headings[index + 1]?.index ?? grammar.indexOf('\n## 6.', start);
    const section = grammar.slice(start, next < 0 ? undefined : next);
    const yaml = /```yaml\n([\s\S]*?)```/u.exec(section)?.[1];
    if (yaml === undefined) return;
    // YAML flow mappings need these values quoted; and the §5.6 dot matrix must show the legend's
    // 4·D² : 8·D² split, one third of 48 = 16 filled (the grammar text says 12; reported upstream).
    const fixed = yaml
      .replace('label: Adam m, v,', 'label: "Adam m, v",')
      .replace('note: on-chip, per SM', 'note: "on-chip, per SM"')
      .replace('note: off-chip, device-wide', 'note: "off-chip, device-wide"')
      .replace(/(type: dots[\s\S]*?filled:) 12(?!\d)/u, '$1 16');
    const parsed: unknown = parseYaml(fixed);
    if (typeof parsed === 'object' && parsed !== null && 'spec' in parsed) out.set(heading[2] ?? '', parsed.spec);
  });
  return out;
}

/** The complete calculator example of §4. */
function calculatorExample(): unknown {
  const body = /```figure\n([\s\S]*?)```/u.exec(grammar)?.[1];
  return body === undefined ? null : (parseYaml(body) as unknown);
}

const problems: string[] = [];
let ordinal = 0;

async function compile(raw: unknown): Promise<CompiledFigure | null> {
  const parsed = FigureSpecSchema.safeParse(raw);
  if (!parsed.success) {
    problems.push(parsed.error.issues.map((issue) => `${issue.path.join('.')}: ${issue.message}`).join('; '));
    return null;
  }
  ordinal += 1;
  const spec = parsed.data;
  return {
    id: spec.id,
    number: `G.${ordinal}`,
    anchor: `fig-g-${ordinal}`,
    origin: 'authored',
    placement: spec.placement,
    regionAnchor: 'grammar',
    spec,
    scene: await layoutFigure(spec),
    evidence: spec.evidence,
    sources: spec.source,
    text: `${spec.alt}\n${describeFigure(spec)}`,
  };
}

interface KindCopy {
  readonly kind: string;
  readonly question: string;
  readonly title: string;
  readonly caption: string;
  readonly alt: string;
  readonly placement?: 'inline' | 'wide';
  readonly source?: string | readonly string[];
  readonly evidence?: string;
}

