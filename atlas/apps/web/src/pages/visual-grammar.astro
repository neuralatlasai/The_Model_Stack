  process: ['QKV projection', '6·D² FLOPs/token', 'An operation that transforms inputs'],
  state: ['decode step', null, 'A condition that persists or changes'],
  tensor: ['scores', '[B, H, T, T]', 'A typed array with a shape'],
  memory: ['KV cache', '[L, B, S, H_kv, Dh]', 'Storage with capacity'],
