const PREFIX = (kind: NodeKind): string => `[${kind.charAt(0).toUpperCase()}${kind.slice(1)}]`;
---

<ReaderLayout
  title="Visual grammar"
  description="Every primitive and figure kind of the Research Atlas visual grammar, drawn by the renderer from the grammar's own examples."
  canonicalPath="/visual-grammar/"
  currentId={null}
  domain="architecture"
>
  <PageHeader
    identity="Research Atlas / Visual grammar"
    title="Visual grammar"
    lede="Fifteen node primitives, four edges, twelve figure kinds, and the live rail instruments, drawn by the renderer from the examples in docs/VISUAL_GRAMMAR.md."
    meta="Edition 1.0 · primitives fixed across the book · every figure numbered, captioned, sourced, and readable as text"
  />

  {problems.length > 0 && (
    <section class="vgr-problems" aria-label="Examples that failed to parse">
      {problems.map((problem) => <p>{problem}</p>)}
    </section>
  )}

  <section class="sh-section vgr-section" aria-labelledby="vgr-primitives" data-kind="primitives">
    <h2 id="vgr-primitives">Node primitives</h2>
    <p class="vgr-lede">One glyph per kind, the same in every diagram, cycle, hierarchy, and concept map. Mermaid label prefixes map onto these kinds.</p>
    <div class="vgr-table-scroll" role="region" aria-label="Node primitives" tabindex="0">
      <table class="vgr-specimens">
        <thead>
          <tr>
            <th scope="col">glyph</th>
            <th scope="col">kind</th>
            <th scope="col">means</th>
          </tr>
        </thead>
        <tbody>
          {NODE_KINDS.map((kind) => {
            const [label, sub, meaning] = NODE_EXAMPLES[kind];
            return (
              <tr data-kind={`node-${kind}`}>
                <td class="vgr-specimens__glyph">
                  <NodeSpecimen kind={kind} label={label} sub={sub} />
                </td>
                <th scope="row">
                  <code>{kind}</code>
                  <span class="vgr-prefix">{PREFIX(kind)}</span>
                </th>
                <td>{meaning}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section class="sh-section vgr-section" aria-labelledby="vgr-edges" data-kind="edges">
    <h2 id="vgr-edges">Edge primitives</h2>
    <div class="vgr-table-scroll" role="region" aria-label="Edge primitives" tabindex="0">
      <table class="vgr-specimens vgr-specimens--edges">
        <tbody>
          {EDGE_KINDS.map((kind) => (
            <tr data-kind={`edge-${kind}`}>
              <td class="vgr-specimens__glyph">
                <EdgeSpecimen kind={kind} label={EDGE_EXAMPLES[kind][0]} />
              </td>
              <th scope="row">
                <code>{kind}</code>
              </th>
              <td>{EDGE_EXAMPLES[kind][1]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="sh-section vgr-section" aria-labelledby="vgr-kinds">
    <h2 id="vgr-kinds">Figure kinds</h2>
    <p class="vgr-lede">Each kind answers one question. The examples are the grammar’s own YAML, parsed, laid out, and drawn exactly as a chapter would draw them.</p>
    {
      kindFigures.map(({ copy, figure }) => (
        <section class:list={['vgr-kind', { 'vgr-kind--wide': copy.placement === 'wide' }]} data-kind={copy.kind} aria-labelledby={`vgr-kind-${copy.kind}`}>
          <h3 id={`vgr-kind-${copy.kind}`} class="vgr-kind__head">
            <code>{copy.kind}</code>
            <span class="vgr-kind__question">{copy.question}</span>
          </h3>
          {figure === null ? <p class="vgr-missing">Example did not parse.</p> : <Figure figure={figure} nodeHref={host(figure).nodeHref} {...host(figure).tex} />}
        </section>
      ))
    }
    <section class="vgr-kind" data-kind="calculator" aria-labelledby="vgr-kind-calculator">
      <h3 id="vgr-kind-calculator" class="vgr-kind__head">
        <code>calculator</code>
        <span class="vgr-kind__question">What happens to this equation’s value when I change a variable?</span>
      </h3>
      <div class="vgr-rail-sample">
        {calculatorFigure === null ? <p class="vgr-missing">Example did not parse.</p> : <Figure figure={calculatorFigure} {...host(calculatorFigure).tex} />}
      </div>
    </section>
    <section class="vgr-kind vgr-kind--wide" data-kind="diagram-groups" aria-labelledby="vgr-kind-diagram-groups">
      <h3 id="vgr-kind-diagram-groups" class="vgr-kind__head">
        <code>diagram</code>
        <span class="vgr-kind__question">Groups, dependencies, and one emphasised path.</span>
      </h3>
      {decoderBlock !== null && <Figure figure={decoderBlock} />}
    </section>
  </section>

  <section class="sh-section vgr-section" aria-labelledby="vgr-live">
    <h2 id="vgr-live">Live instruments</h2>
    <p class="vgr-lede">
      Rail figures carry scroll states. As the reader crosses a region, the instrument lights the parts that region discusses, recomputes its numbers, and replaces its state line. The stepper under each instrument drives the same contract by hand.
    </p>
    <div class="vgr-live">
      {
        live.map((figure) => (
          <div class="vgr-live__item" data-kind={`live-${figure.spec.kind}`}>
            <div class="vgr-rail-sample">
              <Figure figure={figure} {...host(figure).tex} />
            </div>
            <div class="vgr-stepper" role="group" aria-label={`States of ${figure.spec.title}`} data-vgr-for={figure.anchor}>
              {figure.spec.states.map((state, index) => (
                <button type="button" class="vgr-stepper__btn" data-vgr-state={String(index)} aria-pressed={index === 0 ? 'true' : 'false'}>
                  <span class="vgr-stepper__anchor">{state.anchor}</span>
                  <span class="vgr-stepper__label">{state.label ?? `state ${index + 1}`}</span>
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</ReaderLayout>

<script>
  /*
   * Demonstration driver for the live-instrument DOM contract. The reader's
   * rail applies states from scroll position with the same steps:
   *   1. lit parts:  root.has-lit; [data-vg-key] ∈ highlight → .is-lit
   *   2. values:     [data-vg-value="key"].textContent = values[key].text
   *   3. fractions:  [data-vg-frac="key"].style --vg-frac = values[key].frac
   *   4. chart:      [data-vg-cursor].is-on when the state sets x
   *   5. header:     [data-vg-state-label], [data-vg-state-note]
   */
  interface StateValue {
    readonly text: string;
    readonly frac?: number;
  }
  interface ResolvedState {
    readonly label: string | null;
    readonly note: string | null;
    readonly highlight: readonly string[];
    readonly variables: Readonly<Record<string, number>>;
    readonly values: Readonly<Record<string, StateValue>>;
  }

  function applyState(root: HTMLElement, state: ResolvedState): void {
    const lit = new Set(state.highlight);
    root.classList.toggle('has-lit', lit.size > 0);
    for (const part of root.querySelectorAll<HTMLElement | SVGElement>('[data-vg-key]')) {
      part.classList.toggle('is-lit', lit.has(part.getAttribute('data-vg-key') ?? ''));
    }
    for (const [key, value] of Object.entries(state.values)) {
      const selector = CSS.escape(key);
      for (const element of root.querySelectorAll(`[data-vg-value="${selector}"]`)) element.textContent = value.text;
      if (value.frac !== undefined) {
        for (const element of root.querySelectorAll<HTMLElement | SVGElement>(`[data-vg-frac="${selector}"]`)) element.style.setProperty('--vg-frac', String(value.frac));
      }
    }
    const cursor = root.querySelector('[data-vg-cursor]');
    if (cursor !== null) cursor.classList.toggle('is-on', Object.hasOwn(state.variables, 'x'));
    const label = root.querySelector('[data-vg-state-label]');
    if (label !== null) label.textContent = state.label ?? '';
    const note = root.querySelector('[data-vg-state-note]');
    if (note !== null) note.textContent = state.note ?? '';
  }

  for (const stepper of document.querySelectorAll<HTMLElement>('[data-vgr-for]')) {
    const root = document.getElementById(stepper.dataset['vgrFor'] ?? '');
    const raw = root?.getAttribute('data-states');
    if (root === null || root === undefined || raw === null || raw === undefined) continue;
    const states = JSON.parse(raw) as ResolvedState[];
    for (const button of stepper.querySelectorAll<HTMLButtonElement>('[data-vgr-state]')) {
      button.addEventListener('click', () => {
        const state = states[Number(button.dataset['vgrState'])];
        if (state === undefined) return;
        applyState(root, state);
        for (const other of stepper.querySelectorAll('[data-vgr-state]')) other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
      });
    }
  }
</script>

