const live = [liveStat, liveStack, liveChart, liveHier].filter((figure): figure is CompiledFigure => figure !== null);

/* Host inputs the reader passes too: node links and the calculator's server-rendered KaTeX. */
const hosts = new Map<string, FigureHostProps>();
for (const figure of [...kindFigures.map((entry) => entry.figure), calculatorFigure, decoderBlock, ...live]) {
  if (figure !== null) hosts.set(figure.anchor, await figureHostProps(figure));
}
const host = (figure: CompiledFigure): FigureHostProps => hosts.get(figure.anchor) ?? { nodeHref: () => null, tex: {} };

const NODE_EXAMPLES: Readonly<Record<NodeKind, readonly [string, string | null, string]>> = {
