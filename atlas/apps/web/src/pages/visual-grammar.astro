const examples = kindExamples();
const kindFigures: Array<{ copy: KindCopy; figure: CompiledFigure | null }> = [];
for (const [index, copy] of KINDS.entries()) {
  const spec = examples.get(copy.kind);
  const figure =
    spec === undefined
      ? null
      : await compile({
          id: `fig-5.${index + 1}`,
          kind: copy.kind,
          title: copy.title,
          caption: copy.caption,
          placement: copy.placement ?? 'inline',
          evidence: copy.evidence ?? 'MATHEMATICALLY-DERIVED',
          source: copy.source ?? 'DERIVED:eq-5.8',
          alt: copy.alt,
          spec,
        });
  kindFigures.push({ copy, figure });
}
const calculatorFigure = await compile(calculatorExample());

