---
/**
 * Home (UI_UX §36, §83): no marketing. The title, one line of what this is,
 * the scale of the atlas, then the knowledge universe itself as a
 * typographic map — volumes → parts → chapters — beside one real instrument,
 * the reading routes, and the chapters that have manuscripts.
 */
import { isNodeId, type GraphNode, type NodeId, type ResearchDocument } from '@atlas/core';
import AtlasInstrument from '../components/shell/AtlasInstrument.astro';
import type { InstrumentPart, InstrumentRow } from '../lib/instrument.ts';
import ReadingRoutes from '../components/shell/ReadingRoutes.astro';
import UniverseMap from '../components/shell/UniverseMap.astro';
import StackExplorer from '../components/shell/StackExplorer.astro';
import '../styles/explorer.css';
import { buildStackModel } from '../lib/stack.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDocument, getGraph, getManifest, getRegistry } from '../lib/atlas.ts';
import { mapBounded } from '../lib/concurrency.ts';
import { compareStrings, isoDate, plural, stateLabel, updatedLabel } from '../lib/format.ts';
import { SITE_TITLE, siteJsonLd } from '../lib/jsonld.ts';
import { childrenOf, nodesOfType } from '../lib/nodes.ts';
import { routeTables } from '../lib/reading-routes.ts';

const [graph, manifest, registry] = await Promise.all([getGraph(), getManifest(), getRegistry()]);
const compiled = new Set<string>(manifest.documents);
const loadIfCompiled = async (id: NodeId): Promise<ResearchDocument | null> =>
  compiled.has(id) ? getDocument(id) : null;

const chapters = nodesOfType(graph, 'chapter');
const sections = nodesOfType(graph, 'section');
const written = chapters.filter((chapter) => chapter.hasManuscript);

const routesId: NodeId = 'ms.frontmatter.reading-routes';
const routesNode = graph.nodes[routesId] ?? null;
const routesDoc = await loadIfCompiled(routesId);
const routeTable = routesDoc === null ? null : (routeTables(routesDoc)[0] ?? null);
const stackModel = buildStackModel(graph, registry, routesDoc === null ? [] : routeTables(routesDoc).flatMap((table) => table.rows));

interface Recent {
  readonly node: GraphNode;
  readonly updatedAt: string;
  readonly status: string;
  readonly sectionCount: number;
}
const recent: Recent[] = (
  await mapBounded(written, 4, async (node): Promise<Recent | null> => {
    const doc = isNodeId(node.id) ? await loadIfCompiled(node.id) : null;
    if (doc === null) return null;
    return {
      node,
      updatedAt: doc.meta.updatedAt,
      status: stateLabel(doc.meta.editorialStatus),
      sectionCount: childrenOf(graph, node).filter((child) => child.entityType === 'section' && child.hasManuscript).length,
    };
  })
)
  .filter((entry): entry is Recent => entry !== null)
  .sort((a, b) => compareStrings(b.updatedAt, a.updatedAt) || compareStrings(a.node.number ?? '', b.node.number ?? ''));

const scale = [
  plural(chapters.length, 'chapter'),
  plural(sections.length, 'section'),
  plural(manifest.counts.figures, 'figure'),
  plural(manifest.counts.equations, 'equation'),
  plural(manifest.counts.references, 'reference'),
].join(' · ');

const instrumentRows: InstrumentRow[] = [
  { key: 'volumes', value: nodesOfType(graph, 'volume').length, href: '/library/' },
  { key: 'parts', value: nodesOfType(graph, 'part').length, href: '/library/' },
  { key: 'chapters', value: chapters.length, href: '/library/' },
  { key: 'sections', value: sections.length, href: '/library/' },
  { key: 'figures', value: manifest.counts.figures, href: '/figures/' },
  { key: 'equations', value: manifest.counts.equations, href: '/equations/' },
  { key: 'references', value: manifest.counts.references, href: '/papers/' },
  { key: 'glossary terms', value: manifest.counts.terms, href: '/terms/' },
];

const instrumentParts: InstrumentPart[] = nodesOfType(graph, 'part').map((part) => ({
  id: part.id,
  numeral: part.number ?? '',
  title: part.title,
  domain: part.domain,
  dots: childrenOf(graph, part)
    .filter((child) => child.entityType === 'chapter')
    .map((chapter) => {
      const chapterSections = childrenOf(graph, chapter).filter((child) => child.entityType === 'section');
      const writtenSections = chapterSections.filter((section) => section.hasManuscript).length;
      const state = chapter.hasManuscript
        ? `${String(writtenSections)}/${String(chapterSections.length)} sections written`
        : 'planned';
      return {
        id: chapter.id,
        number: chapter.number ?? '',
        title: chapter.title,
        href: chapter.url,
        filled: chapter.hasManuscript,
        readout: `${chapter.number ?? ''} · ${chapter.title} · ${state}`,
      };
    }),
}));
const description =
  'A research atlas of modern model systems — from data and silicon to intelligence: three volumes, eleven parts, sixty-six chapters compiled into typed research objects.';
---

<BaseLayout
  title={SITE_TITLE}
  description={description}
  canonicalPath="/"
  navKey="atlas"
  jsonLd={siteJsonLd(graph, Astro.site, manifest.edition)}
>
  <main id="main" class="sh-home" tabindex="-1">
    <header class="sh-home-head">
      <p class="sh-identity">Research Atlas · Edition {manifest.edition}</p>
      <h1 class="sh-home-title">The Model Stack</h1>
      <p class="sh-home-lede">A research atlas of modern model systems — from data and silicon to intelligence.</p>
      <p class="sh-scale">{scale}</p>
    </header>

    <StackExplorer model={stackModel} />

    <div class="sh-home-grid">
      <section class="sh-home-map" aria-label="Volumes, parts, and chapters">
        <UniverseMap graph={graph} />
      </section>

      <div class="sh-home-side">
        <AtlasInstrument
          header={`EDITION ${manifest.edition} · STATE OF THE ATLAS`}
          rows={instrumentRows}
          parts={instrumentParts}
          legend={{ filled: 'chapters with manuscripts', hollow: 'chapters planned' }}
        />

        {
          routeTable !== null && routesNode !== null && (
            <section class="sh-home-block" aria-labelledby="routes-heading">
              <h2 id="routes-heading" class="sh-block-title">
                Reading routes
              </h2>
              <ReadingRoutes graph={graph} table={routeTable} moreUrl={routesNode.url} />
            </section>
          )
        }

        {
          recent.length > 0 && (
            <section class="sh-home-block" aria-labelledby="recent-heading">
              <h2 id="recent-heading" class="sh-block-title">
                Recently developed
              </h2>
              <ol class="sh-recent">
                {recent.map((entry) => {
                  const iso = isoDate(entry.updatedAt);
                  return (
                    <li class="sh-recent-item" data-domain={entry.node.domain}>
                      <a class="sh-recent-title" href={entry.node.url}>
                        <span class="sh-num">{entry.node.number}</span>
                        {entry.node.title}
                      </a>
                      {entry.node.summary !== null && <p class="sh-recent-summary">{entry.node.summary}</p>}
                      <p class="sh-meta-line">
                        {plural(entry.sectionCount, 'section')} · {entry.status} ·{' '}
                        {iso !== null ? <time datetime={iso}>{updatedLabel(entry.updatedAt)}</time> : updatedLabel(entry.updatedAt)}
                      </p>
                    </li>
                  );
                })}
              </ol>
            </section>
          )
        }
      </div>
    </div>
  </main>
</BaseLayout>
