---
/**
 * Home: one argument beside one image. The narrative states the book's
 * central relationship and walks the stack part by part; the brain — the
 * book as a brain, each region a part, each neuron a chapter, each fibre a
 * declared prerequisite — stays in view and follows it
 * (components/home/BrainStory.astro).
 */
import BrainStory from '../components/home/BrainStory.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGraph, getManifest, getRegistry, listDocuments } from '../lib/atlas.ts';
import { brainMap } from '../lib/brain-map.ts';
import { brainLayout } from '../lib/brain3d.ts';
import { SITE_TITLE, siteJsonLd } from '../lib/jsonld.ts';
import { getStackModel } from '../lib/stack.ts';
import { buildDashboard } from '../lib/stack-dashboard.ts';
import '../styles/home.css';

const [graph, manifest, registry, stack, docs] = await Promise.all([getGraph(), getManifest(), getRegistry(), getStackModel(), listDocuments()]);
const dash = buildDashboard(stack, registry, docs);

const chapters = Object.values(stack.chapters).sort((a, b) => a.n - b.n);
const startUrl = chapters[0]?.url ?? '/library/';
const terms = registry.terms.flatMap((term) => (term.chapter === null ? [] : [{ term: term.term, chapter: term.chapter, url: term.url }]));
const brain = brainMap(
  stack.parts.map((part) => ({ n: part.n, numeral: part.numeral, title: part.title, domain: part.domain, url: part.url })),
  chapters.map((chapter) => ({ n: chapter.n, number: chapter.number, title: chapter.title, url: chapter.url, part: chapter.part, domain: chapter.domain, written: chapter.written })),
  terms,
  stack.edges,
);
const brain3d = brainLayout({
  parts: stack.parts.map((part) => ({ n: part.n, title: part.title, domain: part.domain })),
  chapters: chapters.map((chapter) => ({ n: chapter.n, title: chapter.title, url: chapter.url, part: chapter.part, domain: chapter.domain, written: chapter.written })),
  terms,
  prereqs: stack.edges,
});
const description =
  'The Model Stack: how modern AI models are built, from data and silicon to intelligence — the learning objective, representation, execution, and deployment evidence studied as one loop.';
---

<BaseLayout title={SITE_TITLE} description={description} canonicalPath="/" navKey="atlas" jsonLd={siteJsonLd(graph, Astro.site, manifest.edition)}>
  <main id="main" class="sh-home bs-home" tabindex="-1">
    <BrainStory brain={brain} brain3d={brain3d} stack={stack} dash={dash} startUrl={startUrl} />
  </main>
</BaseLayout>
