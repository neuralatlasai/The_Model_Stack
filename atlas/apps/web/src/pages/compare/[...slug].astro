---
/**
 * Compare mode for one node (UI_UX §14–15): its authored sibling
 * differentials side by side. Rows are the six differential questions
 * (core SIBLING_FIELD_TITLES), columns are the alternatives; rows whose
 * answers differ are emphasised and identical rows recede. Each column head
 * carries the alternative's six-cell glyph from the compare index (filled =
 * answered), so the table and the field read as one instrument; pointing at a
 * cell lights its question, its alternative, and that question's cell in every
 * glyph (CSS only). Below 700 px the table reflows into one block per question.
 */
import type { GetStaticPaths } from 'astro';
import { type LinkTarget, type NodeId } from '@atlas/core';
import Breadcrumbs from '../../components/shell/Breadcrumbs.astro';
import ModeTabs from '../../components/shell/ModeTabs.astro';
import PageHeader from '../../components/shell/PageHeader.astro';
import Inline from '../../components/research/Inline.astro';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import { getDocument, getGraph } from '../../lib/atlas.ts';
import { compareRows, nodesWithCompare, siblingBlocks } from '../../lib/compare.ts';
import { fieldAlternative, gapNote } from '../../lib/compare-field.ts';
import { plural } from '../../lib/format.ts';
import { modeLinks } from '../../lib/modes.ts';
import { compareUrl, pathParam } from '../../lib/urls.ts';
import '../../styles/explorer.css';

type Props = { readonly id: NodeId };

export const getStaticPaths = (async () => {
  const ids = await nodesWithCompare();
  const paths: { params: { slug: string }; props: Props }[] = [];
  for (const id of ids) {
    const doc = await getDocument(id);
    const slug = pathParam(doc.route.url);
    if (slug !== undefined) paths.push({ params: { slug }, props: { id } });
  }
  return paths;
}) satisfies GetStaticPaths;

const { id } = Astro.props;
const [doc, graph] = await Promise.all([getDocument(id), getGraph()]);
const siblings = siblingBlocks(doc);
const rows = compareRows(siblings);
const glyphs = siblings.map(fieldAlternative);
const differing = rows.filter((row) => row.differs).length;
const answered = glyphs.reduce((sum, glyph) => sum + glyph.stated.filter(Boolean).length, 0);
const siblingsRegion = doc.regions.find((region) => region.role === 'siblings') ?? null;
const referencesRegion = doc.regions.find((region) => region.role === 'references') ?? null;
const links = modeLinks({
  graph,
  url: doc.route.url,
  chapter: doc.meta.chapter,
  referencesAnchor: referencesRegion?.anchor ?? null,
  hasCompare: true,
});
const title = doc.header.number === null ? doc.header.title : `${doc.header.number} ${doc.header.title}`;
const hrefOf = (target: LinkTarget | null): string | null => {
  if (target === null) return null;
  switch (target.type) {
    case 'node':
    case 'external':
    case 'planned':
      return target.href;
    case 'unresolved':
      return null;
  }
};
const crumbs = [
  ...doc.route.breadcrumbs,
  { id: doc.meta.id, title: doc.header.title, number: doc.header.number, url: doc.route.url },
];
const sourceHref = siblingsRegion !== null ? `${doc.route.url}#${siblingsRegion.anchor}` : doc.route.url;
---

<ReaderLayout
  title={`Compare · ${title}`}
  description={`Sibling differentials of ${doc.header.title}: why each alternative exists and what it changes.`}
  canonicalPath={compareUrl(doc.route.url)}
  currentId={doc.meta.id}
  domain={graph.nodes[doc.meta.id]?.domain ?? 'reference'}
>
  <Breadcrumbs crumbs={crumbs} current="Compare" />
  <article class="sh-article sh-compare-page gx-page" data-node-id={doc.meta.id}>
    <PageHeader
      identity={`Compare · ${title}`}
      title={`Alternatives to ${doc.header.title}`}
      lede="What each alternative changes, question by question. Not a ranking."
      meta={`${plural(siblings.length, 'alternative')} · ${String(differing)} of ${String(rows.length)} questions differ · ${gapNote(answered, glyphs.length * rows.length)}`}
    />
    <ModeTabs links={links} current="compare" />

    <section class="cmpt gx-inst" aria-labelledby="cmpt-title">
      <p class="gx-head">
        <span class="gx-head__title" id="cmpt-title">
          Differentials
        </span>
        <span class="gx-head__note">
          authored in <a href={sourceHref}>{siblingsRegion?.title ?? 'Siblings'}</a>
        </span>
        <span class="gx-head__keys" aria-hidden="true">
          <span class="cmpx-key cmpx-key--on">answered</span>
          <span class="cmpx-key">not stated</span>
        </span>
      </p>
      <div class="sh-table-scroll cmpt__scroll">
        <table class="sh-table sh-compare cmpt__table" style={`--cmpt-cols:${String(siblings.length)}`}>
          <caption class="sh-visually-hidden">
            Differential explanations of{title}: one row per question, one column per alternative.
          </caption>
          <thead>
            <tr>
              <th scope="col" class="sh-compare-corner cmpt__corner">
                Question
              </th>
              {siblings.map((sibling, index) => {
                const href = hrefOf(sibling.target);
                const glyph = glyphs[index];
                return (
                  <th scope="col" class="sh-compare-head cmpt__head" data-col={index + 1}>
                    <span class="cmpt__hd">
                      <span class="cmpt__glyph" aria-hidden="true">
                        {glyph?.stated.map((on) => (
                          <i class:list={['cmpt__cell', { 'is-on': on }]} />
                        ))}
                      </span>
                      {href !== null ? <a href={href}>{sibling.name}</a> : <span>{sibling.name}</span>}
                    </span>
                  </th>
                );
              })}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, rowIndex) => (
              <tr
                class:list={['sh-compare-row', row.differs ? 'sh-compare-row--differs' : 'sh-compare-row--same']}
                data-row={rowIndex + 1}
              >
                <th scope="row">
                  <span class="cmpt__q-n">{rowIndex + 1}</span>
                  <span class="cmpt__q">{row.title}</span>
                  {!row.differs && row.answered > 1 && <span class="sh-compare-same">same for all</span>}
                </th>
                {row.cells.map((cell, index) => (
                  <td
                    data-col={index + 1}
                    data-alt={siblings[index]?.name ?? ''}
                    class:list={{ 'is-missing': cell === null }}
                  >
                    {cell === null ? <span class="sh-compare-missing">not stated</span> : <Inline nodes={cell} />}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="sh-more">
      <a href={sourceHref}>Back to the reading</a>
    </p>
  </article>
</ReaderLayout>
